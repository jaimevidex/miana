# =============================================================================
# .env.example — tudo o que é preciso do env, descomentado.
# Copiar para .env e preencher. NUNCA commitar o .env real.
#
# Lado 1 — FRONTEND (Astro, PUBLIC_*): usado no build estático.
# Lado 2 — WORKER (funnel Skin Call): em produção vai em wrangler.toml [vars] /
#          secrets; em dev local pode ser sobrescrito num ficheiro .dev.vars.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Astro)
# ─────────────────────────────────────────────────────────────────────────────

# Domínio real do site — sitemap e meta tags Open Graph.
PUBLIC_SITE_URL=https://marianapita.pt

# Google Analytics 4 (GA4). Deixar em branco para desativar.
# Vai a https://analytics.google.com → Criar propriedade → copiar o ID (G-XXXXXXXXXX).
PUBLIC_GA_ID=

# Meta Pixel (Facebook/Meta). Deixar em branco para desativar.
# Vai a https://business.facebook.com → Data Sources → Pixel → copiar o ID (número).
PUBLIC_META_PIXEL_ID=

# Google Search Console — tag de verificação de domínio (o token entre aspas).
# Vai a https://search.google.com/search-console → novo recurso → "Metatag".
PUBLIC_GSC_VERIFICATION=

# Cloudflare Web Analytics (sem cookies, RGPD-friendly). Deixar em branco para desativar.
# Vai ao dashboard Cloudflare → Analytics & Logs → Web Analytics → Add a site → copiar o token do snippet.
PUBLIC_CF_ANALYTICS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# WORKER (funnel Skin Call)
# ─────────────────────────────────────────────────────────────────────────────

# "true" envia email real via Resend; "false" = modo stub/log (para testar sem API key).
EMAIL_ENABLED=false

# Chave de API do Resend (https://resend.com) — envia os emails do funnel.
# Passo a passo: criar conta → adicionar domínio marianapita.pt → copiar API key.
RESEND_API_KEY=re_XXXXXXXXXXXXXX

# Email da dona — recebe o pedido real do diagnóstico (fim do funil).
OWNER_EMAIL=hello@marianapita.pt