---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Marca a página com hero full-bleed escuro (header transparente por cima). */
  hasHero?: boolean;
}

const { title, description, ogImage = '/images/og-default.jpg', hasHero = false } = Astro.props;
const siteURL = new URL(Astro.site ?? 'https://marianapita.pt');
const canonicalURL = new URL(Astro.url.pathname, siteURL);

// Analytics / verificação — ativos apenas quando o respetivo PUBLIC_* tem valor.
const gaId = import.meta.env.PUBLIC_GA_ID?.trim() || '';
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID?.trim() || '';
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION?.trim() || '';
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN?.trim() || '';

// GA4 + Meta Pixel só arrancam depois de consentimento no banner (localStorage 'mp-consent').
const analyticsGate = `(function(){
  var GA='${gaId}', PX='${pixelId}';
  var fired=false;
  function granted(){try{return localStorage.getItem('mp-consent')==='granted'}catch(e){return false}}
  function boot(){
    if(fired)return;fired=true;
    var d=document;
    var s=d.createElement('script');s.async=true;
    s.src='https://www.googletagmanager.com/gtag/js?id='+GA;
    d.head.appendChild(s);
    window.dataLayer=window.dataLayer||[];
    window.gtag=function(){window.dataLayer.push(arguments)};
    window.gtag('js',new Date());
    window.gtag('config',GA);
    if(PX){
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init',PX);fbq('track','PageView');
    }
  }
  if(granted()){boot()}
  else{window.addEventListener('mp-consent-granted',boot,{once:true})}
})();`;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / partilha em redes sociais -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteURL)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Analytics 4 + Meta Pixel — carregados só após consentimento de cookies (ver CookieBanner) -->
    {gaId && <script is:inline set:html={analyticsGate}></script>}

    <!-- Google Search Console — cópia a tag de verificação fornecida pelo Google e cola-a aqui -->
    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    <!-- Cloudflare Web Analytics — só ativo se PUBLIC_CF_ANALYTICS_TOKEN estiver definido em .env (sem cookies) -->
    {cfToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfToken}"}`}
      ></script>
    )}

    <!-- Fontes: Playfair Display + Open Sans (social), Pinyon Script (assinatura) — ver docs/DESIGN.md -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Pinyon+Script&family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  <script is:inline>
      // Roda no head, antes do layout, para impedir a restauração de scroll a saltar o topo.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!window.location.hash) window.scrollTo(0, 0);
    </script>
  </head>
  <body data-hero={hasHero ? 'true' : 'false'}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      // Evita que o browser restaure a posição de scroll entre páginas (salta para baixo).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

      // Ao carregar uma nova página, começa no topo (a menos que haja uma âncora no URL).
      if (!window.location.hash) window.scrollTo(0, 0);

      // Reveal-on-scroll simples, sem dependências, respeita prefers-reduced-motion via CSS.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Scroll-spy: sem escrita no URL. Reservado para realçar a secção ativa no futuro.
      const spySections = Array.from(
        document.querySelectorAll<HTMLElement>('section[id]')
      );
      let activeId: string | null = null;
      const spyUpdate = () => {
        if (!spySections.length) return;
        const header = document.getElementById('site-header');
        const headerH = header?.offsetHeight ?? 80;
        const line = window.scrollY + headerH + 1;
        let current: HTMLElement | null = spySections[0];
        for (const el of spySections) {
          if (el.getBoundingClientRect().top + window.scrollY <= line) current = el;
          else break;
        }
        if (!current) return;
        activeId = current.id;
      };
      const onScroll = () => {
        requestAnimationFrame(spyUpdate);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      spyUpdate();

      // Âncoras internas: rolam até à secção mas não escrevem o hash no URL.
      document.addEventListener(
        'click',
        (e) => {
          const target = e.target as HTMLElement | null;
          const anchor = target?.closest<HTMLAnchorElement>('a[href^="#"]');
          if (!anchor) return;
          const id = anchor.getAttribute('href')?.slice(1);
          if (!id) return;
          const el = document.getElementById(id);
          if (!el) return;
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        },
        { capture: true }
      );
    </script>
  </body>
</html>