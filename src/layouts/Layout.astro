---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Marca a página com hero full-bleed escuro (header transparente por cima). */
  hasHero?: boolean;
}

const { title, description, ogImage = '/images/og-default.jpg', hasHero = false } = Astro.props;
const siteURL = new URL(Astro.site ?? 'https://marianapita.pt');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / partilha em redes sociais -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteURL)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fontes: Playfair Display + Open Sans (social), Pinyon Script (assinatura) — ver docs/DESIGN.md -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Pinyon+Script&family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  <script is:inline>
      // Roda no head, antes do layout, para impedir a restauração de scroll a saltar o topo.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!window.location.hash) window.scrollTo(0, 0);
    </script>
  </head>
  <body data-hero={hasHero ? 'true' : 'false'}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Evita que o browser restaure a posição de scroll entre páginas (salta para baixo).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

      // Ao carregar uma nova página, começa no topo (a menos que haja uma âncora no URL).
      if (!window.location.hash) window.scrollTo(0, 0);

      // Reveal-on-scroll simples, sem dependências, respeita prefers-reduced-motion via CSS.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Scroll-spy: atualiza o hash do URL conforme a secção ativa (sem criar histórico),
      // tanto a rolar para baixo como para cima.
      const spySections = Array.from(
        document.querySelectorAll<HTMLElement>('section[id]')
      );
      let activeId: string | null = null;
      const spyUpdate = () => {
        if (!spySections.length) return;
        const header = document.getElementById('site-header');
        const headerH = header?.offsetHeight ?? 80;
        const line = window.scrollY + headerH + 1;
        let current: HTMLElement | null = spySections[0];
        for (const el of spySections) {
          if (el.getBoundingClientRect().top + window.scrollY <= line) current = el;
          else break;
        }
        if (!current) return;
        const id = current.id;
        if (id !== activeId) {
          activeId = id;
          history.replaceState(null, '', `#${id}`);
        }
      };
      const onScroll = () => {
        requestAnimationFrame(spyUpdate);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      spyUpdate();
    </script>
  </body>
</html>