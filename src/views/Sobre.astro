---
import Layout from '../layouts/Layout.astro';
import Video from '../components/Video.astro';
import { copy, localizePath, type Locale } from '../i18n';

import marianaVideo from '../assets/videos/mariana.mp4';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy(locale);
---

<Layout title={t.meta.sobreTitle} description={t.meta.sobreDescription} locale={locale}>
  <section id="apresentacao" class="pt-32 md:pt-40 pb-28 max-w-container mx-auto px-6 md:px-16">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <p class="eyebrow mb-4 !text-base">{t.sobre.eyebrow}</p>
        <div class="text-darkbrown/75 md:text-justify space-y-4 reveal">
          <p>{t.sobre.p1}</p>
          <h1 class="text-display-l font-bold text-burgundy !mt-12">{t.sobre.title}</h1>
          <p>{t.sobre.p2}</p>
          <p>{t.sobre.p3}</p>
        </div>
      </div>

      <div class="aspect-[6/7]">
        <Video
          sources={[{ src: marianaVideo, type: 'video/mp4' }]}
          aspect="aspect-[6/7]"
          videoClass="origin-center scale-x-[1.04]"
          autoplay
          loop
        />
      </div>
    </div>
  </section>

  <section id="valores" class="bg-offwhite text-darkbrown pt-20 pb-32">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <h2 class="text-display-l font-bold text-center text-burgundy mb-16 reveal">{t.sobre.valuesTitle}</h2>
      <div class="grid md:grid-cols-3 gap-16">
        {t.sobre.pilares.map((p) => (
          <div class="reveal text-center">
            <span class="font-script text-3xl text-burgundy">{p.num}</span>
            <h3 class="font-display text-xl mt-4 mb-3">{p.title}</h3>
            <p class="text-darkbrown/80 text-sm leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="ajuda" class="max-w-container mx-auto px-6 md:px-16 pt-16 pb-40 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-display-l font-display font-bold text-burgundy md:whitespace-nowrap mb-12 reveal">{t.sobre.lookingTitle}</h2>
      <div class="flex flex-wrap justify-center gap-4 reveal">
        <a href={localizePath('/servicos/bridal', locale)} class="border border-burgundy bg-transparent text-burgundy px-6 py-2.5 text-xs font-bold uppercase rounded-full hover:bg-burgundy hover:text-offwhite transition">{t.sobre.ctaBridal}</a>
        <a href={localizePath('/servicos/skin-call', locale)} class="border border-burgundy bg-transparent text-burgundy px-6 py-2.5 text-xs font-bold uppercase rounded-full hover:bg-burgundy hover:text-offwhite transition">{t.sobre.ctaSkinCall}</a>
        <a href={localizePath('/servicos/education', locale)} class="border border-burgundy bg-transparent text-burgundy px-6 py-2.5 text-xs font-bold uppercase rounded-full hover:bg-burgundy hover:text-offwhite transition">{t.sobre.ctaEducation}</a>
      </div>
    </div>
  </section>
</Layout>
