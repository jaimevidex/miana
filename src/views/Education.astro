---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import EducationForm from '../components/forms/EducationForm.astro';
import Hero from '../components/Hero.astro';
import { copy, type Locale } from '../i18n';

import educationHero from '../assets/images/education-hero-1.jpg';
import automaquilhagem from '../assets/images/automaquilhagem.jpg';
import skincareEducation from '../assets/images/skincare-education.jpg';
import friendsParties from '../assets/images/friends-parties.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy(locale);
const e = t.education;
const workshopImages = [automaquilhagem, skincareEducation, friendsParties];
---

<Layout title={t.meta.educationTitle} description={t.meta.educationDescription} hasHero locale={locale}>
  <Hero
    eyebrow={e.heroEyebrow}
    title={e.heroTitle}
    sub={e.heroSub}
    image={educationHero}
    imgStyle="transform: scale(1.25) translateY(18%);"
    locale={locale}
  />

  <section id="intro" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="max-w-4xl mx-auto reveal">
      <blockquote class="font-body text-lg md:text-xl leading-relaxed text-center">
        {e.quote}
      </blockquote>
    </div>
  </section>

  <section id="workshops" class="max-w-container mx-auto px-6 md:px-16 pt-4 pb-24 space-y-24">
    {e.workshops.map((w, i) => (
      <div class="grid md:grid-cols-3 items-end">
        <div class={`relative md:col-span-1 self-center mb-10 md:mb-0 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
          <Image src={workshopImages[i]} alt={w.titulo} loading="lazy" decoding="async"
            style="object-position: center bottom;" class="aspect-[3/4] w-[85%] md:w-full mx-auto object-cover" />
        </div>
        <div class={`md:col-span-2 flex items-end ${i % 2 === 1 ? 'md:order-1 justify-end' : ''}`}>
          <div class={`pb-4 max-w-lg ${i % 2 === 1 ? 'pr-6 md:pr-12 text-right' : 'pl-6 md:pl-12'}`}>
            <h2 class="font-display font-bold text-2xl md:text-3xl leading-tight">{w.titulo}</h2>
            <p class="mt-3 text-xs uppercase tracking-widest text-burgundy">{w.modo}</p>
            <p class="text-darkbrown/75 text-base leading-relaxed mt-4">{w.desc}</p>
          </div>
        </div>
      </div>
    ))}
  </section>

  <section id="education-form" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">{e.formEyebrow}</p>
        <h2 class="text-display-m font-bold mb-4">{e.formTitle}</h2>
      </div>
      <EducationForm locale={locale} />
    </div>
  </section>
</Layout>

<style>
  .ph-tone-0 { background: linear-gradient(135deg, #f6e7e0 0%, #e8c9bc 50%, #a97b86 100%); }
  .ph-tone-1 { background: linear-gradient(135deg, #bddaF4 0%, #8fb8d8 60%, #5d88ab 100%); }
  .ph-tone-2 { background: linear-gradient(135deg, #F4EFFB 0%, #D6C9EC 55%, #9B86C4 100%); }
</style>
