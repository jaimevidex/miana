---
interface Props {
  category: string;
  alt: string;
  image?: string;
  video?: string;
  ratioClass: string;
  imgStyle?: string;
}

const toneByCategory: Record<string, string> = {
  Noivas: 'linear-gradient(160deg, #FFF1EC 0%, #F3D9C8 60%, #C89B7A 100%)',
  Beauty: 'linear-gradient(160deg, #FBEDF0 0%, #E5C1C8 55%, #A97B86 100%)',
  Workshops: 'linear-gradient(160deg, #F4EFFB 0%, #D6C9EC 55%, #9B86C4 100%)',
  Skincare: 'linear-gradient(160deg, #EAF4FA 0%, #C6E0F0 55%, #8FB8D8 100%)',
};

const { category, alt, image, video, ratioClass, imgStyle } = Astro.props;
---

{
  video ? (
    <video
      class={`gallery-placeholder media-blur w-full ${ratioClass} object-cover`}
      src={video}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      data-warm
    ></video>
  ) : image ? (
    <img
      class={`gallery-placeholder media-blur w-full ${ratioClass} object-cover`}
      style={imgStyle}
      src={image}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div
      class={`gallery-placeholder w-full ${ratioClass}`}
      style={`background:${toneByCategory[category] ?? '#EFE7E0'}`}
    ></div>
  )
}

<script>
  // Warm-up: após o load da página, força o download em background dos vídeos
  // da galeria (preload="auto"), para estarem em buffer quando o utilizador
  // chegar à secção. O atraso evita competir com imagens/LCP iniciais.
  const warmVideos = () => {
    document.querySelectorAll<HTMLVideoElement>('video[data-warm]').forEach((v) => {
      if (v.preload === 'auto') return;
      v.preload = 'auto';
      v.load();
    });
  };
  const kick = () => window.setTimeout(warmVideos, 1200);
  if (document.readyState === 'complete') kick();
  else window.addEventListener('load', kick);

  // Blur-up: meios começam desfocados e ficam nítidos assim que há dados.
  const reveal = (el: Element) => el.classList.add('is-loaded');
  document.querySelectorAll('img.media-blur, video.media-blur').forEach((el) => {
    if (el.tagName === 'IMG') {
      const im = el as HTMLImageElement;
      if (im.complete && im.naturalWidth > 0) reveal(im);
      else im.addEventListener('load', () => reveal(im), { once: true });
    } else {
      const v = el as HTMLVideoElement;
      if (v.readyState >= 2) reveal(v);
      else v.addEventListener('loadeddata', () => reveal(v), { once: true });
    }
  });
</script>

<style>
  .media-blur {
    filter: blur(18px);
    transform: scale(1.05);
    transition:
      filter 0.6s ease-out,
      transform 0.6s ease-out;
  }
  .media-blur.is-loaded {
    filter: blur(0);
    transform: none;
  }
</style>
