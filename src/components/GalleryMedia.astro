---
import { Image } from 'astro:assets';

interface Props {
  category: string;
  alt: string;
  image?: ImageMetadata;
  video?: string;
  ratioClass: string;
  imgStyle?: string;
}

const toneByCategory: Record<string, string> = {
  Noivas: 'linear-gradient(160deg, #FFF1EC 0%, #F3D9C8 60%, #C89B7A 100%)',
  Beauty: 'linear-gradient(160deg, #FBEDF0 0%, #E5C1C8 55%, #A97B86 100%)',
  Workshops: 'linear-gradient(160deg, #F4EFFB 0%, #D6C9EC 55%, #9B86C4 100%)',
  Skincare: 'linear-gradient(160deg, #EAF4FA 0%, #C6E0F0 55%, #8FB8D8 100%)',
};

const { category, alt, image, video, ratioClass, imgStyle } = Astro.props;
const bg = toneByCategory[category] ?? '#EFE7E0';
---

<div class={`lqip-box relative w-full ${ratioClass}`} style={`background:${bg}`}>
  {video ? (
    <video
      class="gallery-placeholder media-fade h-full w-full object-cover"
      src={video}
      muted
      loop
      playsinline
      preload="none"
      data-lazy-video
    ></video>
  ) : image ? (
    <Image
      src={image}
      alt={alt}
      class="gallery-placeholder media-fade h-full w-full object-cover"
      style={imgStyle}
      placeholder="blur"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="h-full w-full" style={`background:${bg}`}></div>
  )}
</div>

<style>
  .media-fade {
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }
  .lqip-box.is-loaded .media-fade {
    opacity: 1;
  }
</style>

<script>
  const reveal = (el: Element) => el.closest('.lqip-box')?.classList.add('is-loaded');

  // Images
  document.querySelectorAll('img.media-fade').forEach((el) => {
    const im = el as HTMLImageElement;
    if (im.complete && im.naturalWidth > 0) reveal(im);
    else im.addEventListener('load', () => reveal(im), { once: true });
  });

  // Videos - load + play only when entering viewport
  const videoObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const v = entry.target as HTMLVideoElement;
          v.preload = 'auto';
          v.load();
          v.play?.().catch(() => {});
          reveal(v);
          videoObserver.unobserve(v);
        }
      }
    },
    { rootMargin: '200px' }
  );
  document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]').forEach((v) => {
    videoObserver.observe(v);
  });
</script>