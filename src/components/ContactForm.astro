---
// Serviço: Web3Forms (https://web3forms.com) — gratuito, sem backend.
// Substituir WEB3FORMS_ACCESS_KEY pela key real gerada na conta Web3Forms.
const WEB3FORMS_ACCESS_KEY = 'COLOCAR_ACCESS_KEY_AQUI';
---

<form
  id="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="grid gap-5 max-w-xl"
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="Novo pedido de orçamento — site" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div>
    <label for="name" class="text-sm font-medium text-espresso">Nome</label>
    <input
      id="name" name="name" type="text" required
      class="mt-1 w-full border border-argila/30 rounded-sm px-4 py-3 bg-creme focus:border-vinho outline-none"
    />
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="email" class="text-sm font-medium text-espresso">Email</label>
      <input
        id="email" name="email" type="email" required
        class="mt-1 w-full border border-argila/30 rounded-sm px-4 py-3 bg-creme focus:border-vinho outline-none"
      />
    </div>
    <div>
      <label for="phone" class="text-sm font-medium text-espresso">Telefone (opcional)</label>
      <input
        id="phone" name="phone" type="tel"
        class="mt-1 w-full border border-argila/30 rounded-sm px-4 py-3 bg-creme focus:border-vinho outline-none"
      />
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label for="service" class="text-sm font-medium text-espresso">Tipo de serviço</label>
      <select
        id="service" name="service"
        class="mt-1 w-full border border-argila/30 rounded-sm px-4 py-3 bg-creme focus:border-vinho outline-none"
      >
        <option>Noiva</option>
        <option>Editorial</option>
        <option>Dia-a-dia</option>
        <option>Evento</option>
        <option>Outro</option>
      </select>
    </div>
    <div>
      <label for="event_date" class="text-sm font-medium text-espresso">Data do evento (opcional)</label>
      <input
        id="event_date" name="event_date" type="date"
        class="mt-1 w-full border border-argila/30 rounded-sm px-4 py-3 bg-creme focus:border-vinho outline-none"
      />
    </div>
  </div>

  <div>
    <label for="message" class="text-sm font-medium text-espresso">Mensagem</label>
    <textarea
      id="message" name="message" rows="5" required
      class="mt-1 w-full border border-argila/30 rounded-sm px-4 py-3 bg-creme focus:border-vinho outline-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="bg-vinho text-creme px-6 py-3.5 text-sm font-semibold rounded-sm hover:bg-opacity-90 transition w-fit"
  >
    Enviar pedido
  </button>

  <p id="form-status" class="text-sm mt-2" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    status.textContent = 'A enviar...';
    status.className = 'text-sm mt-2 text-argila';

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = 'Obrigada pelo teu contacto! Respondo em até 48h.';
        status.className = 'text-sm mt-2 text-vinho font-medium';
        form.reset();
      } else {
        throw new Error(result.message || 'Erro ao enviar');
      }
    } catch (err) {
      status.textContent = 'Algo correu mal. Tenta novamente ou escreve para o email indicado.';
      status.className = 'text-sm mt-2 text-red-700';
    }
  });
</script>
