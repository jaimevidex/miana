---
const inputCls =
  'mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none';
const radioCls = 'accent-burgundy';
const labelCls = 'block text-sm font-medium text-darkbrown';
---

<form
  id="form-bridal"
  action="/api/contact"
  method="POST"
  novalidate
  class="grid gap-5"
>
  <input type="hidden" name="subject" value="Pedido — Bridal &amp; Beauty" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="b-name">Nome completo <span class="text-burgundy">*</span></label>
      <input id="b-name" name="nome" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="b-phone">Contacto telefónico <span class="text-burgundy">*</span></label>
      <input id="b-phone" name="telefone" type="tel" required class={inputCls} />
    </div>
  </div>

<div>
      <label class={labelCls} for="b-email">E-mail <span class="text-burgundy">*</span></label>
      <input id="b-email" name="email" type="email" required class={inputCls} />
    </div>

  <fieldset>
    <legend class={labelCls}>Opção de Serviço <span class="text-burgundy">*</span></legend>
    <div class="flex flex-wrap gap-6 mt-2">
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="opcao_servico" value="Bride" required class={radioCls} data-service-opt="bride" />
        Bride
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="opcao_servico" value="Guests & Events" required class={radioCls} data-service-opt="guests" />
        Guests &amp; Events
      </label>
    </div>
  </fieldset>

  <!-- Campos BRIDE -->
  <div id="bride-fields" class="grid gap-5">
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="b-wedding-date">Data do casamento <span class="text-burgundy">*</span></label>
        <input id="b-wedding-date" name="data_casamento" type="date" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls} for="b-ready-time">Hora a que tens de estar pronta <span class="text-burgundy">*</span></label>
        <input id="b-ready-time" name="hora_pronta" type="time" required class={inputCls} />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="b-prep-location">Local da preparação <span class="text-burgundy">*</span></label>
        <input id="b-prep-location" name="local_preparacao" type="text" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls} for="b-trial-location">Local da prova <span class="text-burgundy">*</span></label>
        <input id="b-trial-location" name="local_prova" type="text" required class={inputCls} />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <fieldset>
        <legend class={labelCls}>Que serviços procuras? <span class="text-burgundy">*</span></legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados" value="Makeup" required class={radioCls} />
            Makeup
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados" value="Makeup + Hair" required class={radioCls} />
            Makeup + Hair
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados" value="Hair" required class={radioCls} />
            Hair
          </label>
        </div>
      </fieldset>
      <div>
        <label class={labelCls} for="b-guests">Número de guests <span class="text-burgundy">*</span></label>
        <input id="b-guests" name="numero_guests" type="number" min="0" required class={inputCls} />
      </div>
    </div>
    <fieldset>
      <legend class={labelCls}>Queres adicionar o Add-on Skin Call? <span class="text-burgundy">*</span></legend>
      <div class="flex flex-wrap gap-6 mt-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="addon_skin_call" value="Sim" required class={radioCls} />
          Sim
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="addon_skin_call" value="Não" required class={radioCls} />
          Não
        </label>
      </div>
    </fieldset>
  </div>

  <!-- Campos GUESTS & EVENTS -->
  <div id="guests-fields" class="grid gap-5 hidden">
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="b-event-date">Data do evento <span class="text-burgundy">*</span></label>
        <input id="b-event-date" name="data_evento" type="date" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls} for="b-event-ready-time">Hora a que tens de estar pronta <span class="text-burgundy">*</span></label>
        <input id="b-event-ready-time" name="hora_pronta_evento" type="time" required class={inputCls} />
      </div>
    </div>
    <div>
      <label class={labelCls} for="b-event-location">Local do serviço / preparação <span class="text-burgundy">*</span></label>
      <input id="b-event-location" name="local_evento" type="text" required class={inputCls} />
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <fieldset>
        <legend class={labelCls}>Que serviços procuras? <span class="text-burgundy">*</span></legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados_guests" value="Makeup" required class={radioCls} />
            Makeup
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados_guests" value="Makeup + Hair" required class={radioCls} />
            Makeup + Hair
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados_guests" value="Hair" required class={radioCls} />
            Hair
          </label>
        </div>
      </fieldset>
      <div>
        <label class={labelCls} for="b-people">Número de pessoas <span class="text-burgundy">*</span></label>
        <input id="b-people" name="numero_pessoas" type="number" min="1" required class={inputCls} />
      </div>
    </div>
  </div>

  <div>
    <label class={labelCls} for="b-message">Mensagem (opcional)</label>
    <textarea id="b-message" name="mensagem" rows="4" class={inputCls}></textarea>
  </div>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> Campos obrigatórios</p>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
      Pedir Orçamento
    </button>
    <p id="form-bridal-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { submitForm, validateRequiredFields, scrollFormIntoView } from '../../lib/web3form';

  const form = document.getElementById('form-bridal') as HTMLFormElement | null;
  const status = document.getElementById('form-bridal-status');
  const brideFields = document.getElementById('bride-fields');
  const guestsFields = document.getElementById('guests-fields');

  const showFields = (opt: string) => {
    const isBride = opt === 'bride';
    brideFields?.classList.toggle('hidden', !isBride);
    guestsFields?.classList.toggle('hidden', isBride);
  };

  form?.querySelectorAll<HTMLInputElement>('[data-service-opt]').forEach((radio) => {
    radio.addEventListener('change', () => showFields(radio.getAttribute('data-service-opt') ?? ''));
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateRequiredFields(form)) {
      scrollFormIntoView(form);
      return;
    }
    void submitForm(form, status);
  });
</script>