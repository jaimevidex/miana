---
import { getAccessKey, submitWeb3Form } from '../../lib/web3form';

const accessKey = getAccessKey();

const inputCls =
  'mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form
  id="form-bridal"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="grid gap-5"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Pedido — Bridal &amp; Beauty" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="b-name">Nome completo <span class="text-burgundy">*</span></label>
      <input id="b-name" name="nome" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="b-phone">Contacto telefónico</label>
      <input id="b-phone" name="telefone" type="tel" class={inputCls} />
    </div>
  </div>

  <div>
    <label class={labelCls} for="b-email">E-mail</label>
    <input id="b-email" name="email" type="email" class={inputCls} />
  </div>

  <fieldset>
    <legend class={labelCls}>Opção de Serviço</legend>
    <div class="flex flex-wrap gap-6 mt-2">
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="opcao_servico" value="Bride" checked class={radioCls} data-service-opt="bride" />
        Bride
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="opcao_servico" value="Guests & Events" class={radioCls} data-service-opt="guests" />
        Guests &amp; Events
      </label>
    </div>
  </fieldset>

  <!-- Campos BRIDE -->
  <div id="bride-fields" class="grid gap-5">
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="b-wedding-date">Data do casamento <span class="text-burgundy">*</span></label>
        <input id="b-wedding-date" name="data_casamento" type="date" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls} for="b-ready-time">Hora a que tens de estar pronta <span class="text-burgundy">*</span></label>
        <input id="b-ready-time" name="hora_pronta" type="time" required class={inputCls} />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="b-prep-location">Local da preparação <span class="text-burgundy">*</span></label>
        <input id="b-prep-location" name="local_preparacao" type="text" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls} for="b-trial-location">Local da prova <span class="text-burgundy">*</span></label>
        <input id="b-trial-location" name="local_prova" type="text" required class={inputCls} />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <fieldset>
        <legend class={labelCls}>Que serviços procuras?</legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados" value="Makeup" checked class={radioCls} />
            Makeup
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados" value="Makeup + Hair" class={radioCls} />
            Makeup + Hair
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados" value="Hair" class={radioCls} />
            Hair
          </label>
        </div>
      </fieldset>
      <div>
        <label class={labelCls} for="b-guests">Número de guests <span class="text-burgundy">*</span></label>
        <input id="b-guests" name="numero_guests" type="number" min="0" required class={inputCls} />
      </div>
    </div>
    <fieldset>
      <legend class={labelCls}>Queres adicionar o Add-on Skin Call?</legend>
      <div class="flex flex-wrap gap-6 mt-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="addon_skin_call" value="Sim" checked class={radioCls} />
          Sim
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="addon_skin_call" value="Não" class={radioCls} />
          Não
        </label>
      </div>
    </fieldset>
  </div>

  <!-- Campos GUESTS & EVENTS -->
  <div id="guests-fields" class="grid gap-5 hidden">
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="b-event-date">Data do evento</label>
        <input id="b-event-date" name="data_evento" type="date" class={inputCls} />
      </div>
      <div>
        <label class={labelCls} for="b-event-ready-time">Hora a que tens de estar pronta</label>
        <input id="b-event-ready-time" name="hora_pronta_evento" type="time" class={inputCls} />
      </div>
    </div>
    <div>
      <label class={labelCls} for="b-event-location">Local do serviço / preparação</label>
      <input id="b-event-location" name="local_evento" type="text" class={inputCls} />
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <fieldset>
        <legend class={labelCls}>Que serviços procuras?</legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados_guests" value="Makeup" checked class={radioCls} />
            Makeup
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados_guests" value="Makeup + Hair" class={radioCls} />
            Makeup + Hair
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="servicos_procurados_guests" value="Hair" class={radioCls} />
            Hair
          </label>
        </div>
      </fieldset>
      <div>
        <label class={labelCls} for="b-people">Número de pessoas</label>
        <input id="b-people" name="numero_pessoas" type="number" min="1" class={inputCls} />
      </div>
    </div>
  </div>

  <div>
    <label class={labelCls} for="b-message">Mensagem (opcional)</label>
    <textarea id="b-message" name="mensagem" rows="4" class={inputCls}></textarea>
  </div>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> Campos obrigatórios</p>

  <button type="submit" class="w-fit bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
    Pedir Orçamento
  </button>

  <p id="form-bridal-status" class="mt-2" role="status" aria-live="polite"></p>
</form>

<script>
  import { submitWeb3Form } from '../../lib/web3form';

  const form = document.getElementById('form-bridal') as HTMLFormElement | null;
  const status = document.getElementById('form-bridal-status');
  const brideFields = document.getElementById('bride-fields');
  const guestsFields = document.getElementById('guests-fields');

  const showFields = (opt: string) => {
    const isBride = opt === 'bride';
    brideFields?.classList.toggle('hidden', !isBride);
    guestsFields?.classList.toggle('hidden', isBride);
  };

  form?.querySelectorAll<HTMLInputElement>('[data-service-opt]').forEach((radio) => {
    radio.addEventListener('change', () => showFields(radio.getAttribute('data-service-opt') ?? ''));
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const phone = (form.querySelector<HTMLInputElement>('[name="telefone"]')?.value ?? '').trim();
    const email = (form.querySelector<HTMLInputElement>('[name="email"]')?.value ?? '').trim();
    if (!phone && !email) {
      if (status) status.textContent = 'Coloca pelo menos um contacto para poder responder-te.';
      return;
    }
    void submitWeb3Form(form, status);
  });
</script>