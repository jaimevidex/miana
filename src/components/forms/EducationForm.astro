---
const inputCls =
  'mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form id="form-education" action="/api/lead" method="POST" novalidate class="grid gap-5">
  <input type="hidden" name="form_type" value="education" />
  <input type="hidden" name="subject" value="Pedido - Education" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="e-name">Nome completo <span class="text-burgundy">*</span></label>
      <input id="e-name" name="nome" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-phone">Contacto telefónico <span class="text-burgundy">*</span></label>
      <input id="e-phone" name="telefone" type="tel" required class={inputCls} />
    </div>
  </div>

  <div>
    <label class={labelCls} for="e-email">E-mail <span class="text-burgundy">*</span></label>
    <input id="e-email" name="email" type="email" required class={inputCls} />
  </div>

  <fieldset>
    <legend class={labelCls}>Formato pretendido <span class="text-burgundy">*</span></legend>
    <div class="grid gap-2 mt-3">
      {[
        { v: 'Automaquilhagem', t: 'Automaquilhagem' },
        { v: 'Skincare Education', t: 'Skincare Education' },
        { v: 'Friends & Bachelorette Parties', t: 'Friends & Bachelorette Parties' },
      ].map((f) => (
        <label class="inline-flex items-center gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
          <input type="radio" name="formato" value={f.v} required class={radioCls} data-formato={f.v} />
          <span>{f.t}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="e-location">Local do workshop <span class="text-burgundy">*</span></label>
      <input id="e-location" name="local_workshop" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-datetime">Data e hora propostas <span class="text-burgundy">*</span></label>
      <input id="e-datetime" name="data_hora" type="datetime-local" required class={inputCls} />
    </div>
  </div>

  <fieldset>
    <legend class={labelCls}>És uma empresa ou particular? <span class="text-burgundy">*</span></legend>
    <div class="flex flex-wrap gap-6 mt-2">
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="tipo" value="Empresa" required class={radioCls} />
        Empresa
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="tipo" value="Particular" required class={radioCls} />
        Particular
      </label>
    </div>
  </fieldset>

  <!-- Campos adicionais FRIENDS & BACHELORETTE PARTIES -->
  <div id="group-fields" class="grid gap-5 hidden">
    <fieldset>
      <legend class={labelCls}>Qual a modalidade pretendida? <span class="text-burgundy">*</span></legend>
      <div class="flex flex-wrap gap-6 mt-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="modalidade" value="Makeup" required class={radioCls} />
          Makeup
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="modalidade" value="Skincare" required class={radioCls} />
          Skincare
        </label>
      </div>
    </fieldset>
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="e-participants">Número de participantes <span class="text-burgundy">*</span></label>
        <input id="e-participants" name="numero_participantes" type="number" min="1" required class={inputCls} />
      </div>
      <fieldset>
        <legend class={labelCls}>Regime pretendido <span class="text-burgundy">*</span></legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="regime" value="Masterclass" required class={radioCls} />
            Masterclass
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="regime" value="Hands-on" required class={radioCls} />
            Hands-on
          </label>
        </div>
      </fieldset>
    </div>
  </div>

  <div>
    <label class={labelCls} for="e-notes">Mensagem (opcional)</label>
    <textarea id="e-notes" name="mensagem" rows={5} class="mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none resize-y"></textarea>
  </div>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> Campos obrigatórios</p>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
      Pedir Orçamento
    </button>
    <p id="form-education-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { submitForm, validateRequiredFields, scrollFormIntoView } from '../../lib/form-utils';

  const form = document.getElementById('form-education') as HTMLFormElement | null;
  const status = document.getElementById('form-education-status');
  const groupFields = document.getElementById('group-fields');

  form?.querySelectorAll<HTMLInputElement>('[data-formato]').forEach((radio) => {
    radio.addEventListener('change', () => {
      const isGroup = radio.getAttribute('data-formato') === 'Friends & Bachelorette Parties';
      groupFields?.classList.toggle('hidden', !isGroup);
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateRequiredFields(form)) {
      scrollFormIntoView(form);
      return;
    }
    void submitForm(form, status);
  });
</script>