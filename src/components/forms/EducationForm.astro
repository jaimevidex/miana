---
import { copy, localeFromPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = copy(locale);
const f = t.forms;
const e = f.education;
const inputCls =
  'mt-1 w-full border border-powder/40 rounded-sm px-4 py-3 bg-powder/40 focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form
  id="form-education"
  action="/api/lead"
  method="POST"
  novalidate
  class="grid gap-5"
  data-msg-sending={f.sending}
  data-msg-success={f.success}
  data-msg-error={f.error}
>
  <input type="hidden" name="form_type" value="education" />
  <input type="hidden" name="subject" value="Pedido - Education" />
  <input type="hidden" name="locale" value={locale} />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="e-name">{f.fullName} <span class="text-burgundy">*</span></label>
      <input id="e-name" name="nome" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-phone">{f.phone} <span class="text-burgundy">*</span></label>
      <input id="e-phone" name="telefone" type="tel" required class={inputCls} />
    </div>
  </div>

  <div>
    <label class={labelCls} for="e-email">{f.email} <span class="text-burgundy">*</span></label>
    <input id="e-email" name="email" type="email" required class={inputCls} />
  </div>

  <fieldset>
    <legend class={labelCls}>{e.format} <span class="text-burgundy">*</span></legend>
    <div class="grid gap-2 mt-3">
      {e.formats.map((fmt) => (
        <label class="inline-flex items-center gap-3 text-sm bg-powder/40 border border-powder/40 rounded-sm px-4 py-3">
          <input type="radio" name="formato" value={fmt.value} required class={radioCls} data-formato={fmt.value} />
          <span>{fmt.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="e-location">{e.location} <span class="text-burgundy">*</span></label>
      <input id="e-location" name="local_workshop" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-datetime">{e.datetime} <span class="text-burgundy">*</span></label>
      <input id="e-datetime" name="data_hora" type="datetime-local" required class={inputCls} />
    </div>
  </div>

  <fieldset>
    <legend class={labelCls}>{e.companyOrPrivate} <span class="text-burgundy">*</span></legend>
    <div class="flex flex-wrap gap-6 mt-2">
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="tipo" value="Empresa" required class={radioCls} />
        {e.company}
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="tipo" value="Particular" required class={radioCls} />
        {e.private}
      </label>
    </div>
  </fieldset>

  <!-- Campos adicionais FRIENDS & BACHELORETTE PARTIES -->
  <div id="group-fields" class="grid gap-5 hidden">
    <fieldset>
      <legend class={labelCls}>{e.modality} <span class="text-burgundy">*</span></legend>
      <div class="flex flex-wrap gap-6 mt-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="modalidade" value="Makeup" required class={radioCls} />
          {e.makeup}
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="modalidade" value="Skincare" required class={radioCls} />
          {e.skincare}
        </label>
      </div>
    </fieldset>
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="e-participants">{e.participants} <span class="text-burgundy">*</span></label>
        <input id="e-participants" name="numero_participantes" type="number" min="1" required class={inputCls} />
      </div>
      <fieldset>
        <legend class={labelCls}>{e.regime} <span class="text-burgundy">*</span></legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="regime" value="Masterclass" required class={radioCls} />
            {e.masterclass}
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="regime" value="Hands-on" required class={radioCls} />
            {e.handsOn}
          </label>
        </div>
      </fieldset>
    </div>
  </div>

  <div>
    <label class={labelCls} for="e-notes">{f.message}</label>
    <textarea id="e-notes" name="mensagem" rows={5} class="mt-1 w-full border border-powder/40 rounded-sm px-4 py-3 bg-powder/40 focus:border-burgundy outline-none resize-y"></textarea>
  </div>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> {f.requiredNote}</p>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
      {f.submit}
    </button>
    <p id="form-education-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { submitForm, validateRequiredFields, scrollFormIntoView } from '../../lib/form-utils';

  const form = document.getElementById('form-education') as HTMLFormElement | null;
  const status = document.getElementById('form-education-status');
  const groupFields = document.getElementById('group-fields');

  form?.querySelectorAll<HTMLInputElement>('[data-formato]').forEach((radio) => {
    radio.addEventListener('change', () => {
      const isGroup = radio.getAttribute('data-formato') === 'Friends & Bachelorette Parties';
      groupFields?.classList.toggle('hidden', !isGroup);
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateRequiredFields(form)) {
      scrollFormIntoView(form);
      return;
    }
    void submitForm(form, status);
  });
</script>
