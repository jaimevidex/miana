---
import { getAccessKey, submitWeb3Form } from '../../lib/web3form';

const accessKey = getAccessKey();

const inputCls =
  'mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form id="form-education" action="https://api.web3forms.com/submit" method="POST" class="grid gap-5">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Pedido — Beauty Education (Workshop)" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-3 gap-5">
    <div>
      <label class={labelCls} for="e-name">Nome completo</label>
      <input id="e-name" name="nome" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-phone">Contacto telefónico</label>
      <input id="e-phone" name="telefone" type="tel" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-email">E-mail</label>
      <input id="e-email" name="email" type="email" required class={inputCls} />
    </div>
  </div>

  <fieldset>
    <legend class={labelCls}>Formato pretendido</legend>
    <div class="grid gap-2 mt-3">
      {[
        { v: 'Automaquilhagem 1:1', t: 'Automaquilhagem 1:1 (Presencial)' },
        { v: 'Skincare Education', t: 'Skincare Education' },
        { v: 'Group Sessions & Bachelorette Parties', t: 'Group Sessions & Bachelorette Parties' },
      ].map((f) => (
        <label class="inline-flex items-center gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
          <input type="radio" name="formato" value={f.v} required class={radioCls} data-formato={f.v} />
          <span>{f.t}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="e-location">Local do workshop</label>
      <input id="e-location" name="local_workshop" type="text" class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="e-datetime">Data e hora propostas</label>
      <input id="e-datetime" name="data_hora" type="datetime-local" class={inputCls} />
    </div>
  </div>

  <fieldset>
    <legend class={labelCls}>És uma empresa ou particular?</legend>
    <div class="flex flex-wrap gap-6 mt-2">
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="tipo" value="Empresa" checked class={radioCls} />
        Empresa
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="radio" name="tipo" value="Particular" class={radioCls} />
        Particular
      </label>
    </div>
  </fieldset>

  <!-- Campos adicionais GROUP SESSIONS & BACHELORETTE PARTIES -->
  <div id="group-fields" class="grid gap-5 hidden">
    <fieldset>
      <legend class={labelCls}>Qual a modalidade pretendida?</legend>
      <div class="flex flex-wrap gap-6 mt-2">
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="modalidade" value="Makeup" checked class={radioCls} />
          Makeup
        </label>
        <label class="inline-flex items-center gap-2 text-sm">
          <input type="radio" name="modalidade" value="Skincare" class={radioCls} />
          Skincare
        </label>
      </div>
    </fieldset>
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class={labelCls} for="e-participants">Número de participantes</label>
        <input id="e-participants" name="numero_participantes" type="number" min="1" class={inputCls} />
      </div>
      <fieldset>
        <legend class={labelCls}>Regime pretendido</legend>
        <div class="flex flex-wrap gap-6 mt-2">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="regime" value="Masterclass" checked class={radioCls} />
            Masterclass
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="regime" value="Hands-on" class={radioCls} />
            Hands-on
          </label>
        </div>
      </fieldset>
    </div>
  </div>

  <button type="submit" class="w-fit bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
    Agendar o teu Workshop
  </button>

  <p id="form-education-status" class="mt-2" role="status" aria-live="polite"></p>
</form>

<script>
  import { submitWeb3Form } from '../../lib/web3form';

  const form = document.getElementById('form-education') as HTMLFormElement | null;
  const status = document.getElementById('form-education-status');
  const groupFields = document.getElementById('group-fields');

  form?.querySelectorAll<HTMLInputElement>('[data-formato]').forEach((radio) => {
    radio.addEventListener('change', () => {
      const isGroup = radio.getAttribute('data-formato') === 'Group Sessions & Bachelorette Parties';
      groupFields?.classList.toggle('hidden', !isGroup);
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    void submitWeb3Form(form, status);
  });
</script>