---
import { copy, localeFromPath, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = copy(locale);
const f = t.forms;
const s = f.skin;
const inputCls =
  'mt-1 w-full border border-powder/40 rounded-sm px-4 py-3 bg-powder/40 focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form
  id="form-skin-call"
  action="/api/lead"
  method="POST"
  novalidate
  class="grid gap-6"
  data-msg-sending={f.sending}
  data-msg-success={f.skinCallSuccess}
  data-msg-error={f.error}
>
  <input type="hidden" name="form_type" value="skin-call" />
  <input type="hidden" name="locale" value={locale} />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-x-32 gap-y-6">
    <div class="flex flex-col gap-6">
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class={labelCls} for="sc-name">{f.fullName} <span class="text-burgundy">*</span></label>
          <input id="sc-name" name="nome" type="text" required class={inputCls} />
        </div>
        <div>
          <label class={labelCls} for="sc-phone">{f.phone} <span class="text-burgundy">*</span></label>
          <input id="sc-phone" name="telefone" type="tel" required class={inputCls} />
        </div>
      </div>

      <div>
        <label class={labelCls} for="sc-email">{f.email} <span class="text-burgundy">*</span></label>
        <input id="sc-email" name="email" type="email" required class={inputCls} />
      </div>

      <fieldset>
        <legend class={labelCls}>{s.plan} <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {s.plans.map((p) => (
            <label class="inline-flex items-start gap-3 text-sm bg-powder/40 border border-powder/40 rounded-sm px-4 py-3">
              <input type="radio" name="plano" value={p.value} required class={`${radioCls} mt-0.5`} />
              <span>{p.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div>
        <label class={labelCls} for="sc-rotina">{s.routine} <span class="text-burgundy">*</span></label>
        <textarea id="sc-rotina" name="rotina" required rows={4} class={inputCls} placeholder={s.routinePlaceholder} />
      </div>

      <fieldset>
        <legend class={labelCls}>{s.frequency} <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {s.frequencies.map((o) => (
            <label class="inline-flex items-start gap-3 text-sm bg-powder/40 border border-powder/40 rounded-sm px-4 py-3">
              <input type="radio" name="rotina_frequencia" value={o.value} required class={`${radioCls} mt-0.5`} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="flex flex-col gap-6">
      <fieldset>
        <legend class={labelCls}>{s.skinFeel} <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {s.skinTypes.map((o) => (
            <label class="inline-flex items-start gap-3 text-sm bg-powder/40 border border-powder/40 rounded-sm px-4 py-3">
              <input type="checkbox" name="pele_tipo" value={o.value} class={`${radioCls} mt-0.5`} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class={labelCls}>{s.concerns} <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {s.concernOptions.map((o) => (
            <label class="inline-flex items-start gap-3 text-sm bg-powder/40 border border-powder/40 rounded-sm px-4 py-3">
              <input type="checkbox" name="preocupacoes" value={o.value} class={`${radioCls} mt-0.5`} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
        <div id="preocupacoes-outro-wrap" class="hidden mt-2">
          <input type="text" name="preocupacoes_outro" placeholder={s.otherPlaceholder} class={inputCls} />
        </div>
      </fieldset>
    </div>
  </div>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> {f.requiredNote}</p>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
      {f.submit}
    </button>
    <p id="form-skin-call-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { submitForm, validateRequiredFields, scrollFormIntoView } from '../../lib/form-utils';

  const form = document.getElementById('form-skin-call') as HTMLFormElement | null;
  const status = document.getElementById('form-skin-call-status');

  const outroWrap = document.getElementById('preocupacoes-outro-wrap');
  const outroInput = outroWrap?.querySelector('input') as HTMLInputElement | null;

  form?.querySelectorAll('input[name="preocupacoes"]').forEach((cb) => {
    cb.addEventListener('change', () => {
      const checked = form.querySelectorAll('input[name="preocupacoes"]:checked');
      const hasOutro = Array.from(checked).some((c) => (c as HTMLInputElement).value === 'Outra');
      outroWrap?.classList.toggle('hidden', !hasOutro);
      if (!hasOutro && outroInput) outroInput.value = '';
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateRequiredFields(form)) {
      scrollFormIntoView(form);
      return;
    }
    void submitForm(form, status);
  });
</script>
