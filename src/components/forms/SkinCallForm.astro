---
const inputCls =
  'mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form id="form-skin-call" action="/api/lead" method="POST" novalidate class="grid gap-6">
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={labelCls} for="sc-name">Nome completo <span class="text-burgundy">*</span></label>
      <input id="sc-name" name="nome" type="text" required class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="sc-phone">Contacto telefónico <span class="text-burgundy">*</span></label>
      <input id="sc-phone" name="telefone" type="tel" required class={inputCls} />
    </div>
  </div>

  <div>
    <label class={labelCls} for="sc-email">E-mail <span class="text-burgundy">*</span></label>
    <input id="sc-email" name="email" type="email" required class={inputCls} />
  </div>

  <fieldset>
    <legend class={labelCls}>Qual o plano que procuras? <span class="text-burgundy">*</span></legend>
    <div class="grid gap-2 mt-3">
      {[
        { v: 'One Time Call (Plano 3M)', t: 'One Time Call - Plano 3M' },
        { v: 'Duo Call (Plano 6M)', t: 'Duo Call - Plano 6M' },
        { v: 'Triple Call (Plano 9M)', t: 'Triple Call - Plano 9M' },
        { v: 'Full Year Call (Plano 12M)', t: 'Full Year Call - Plano 12M' },
        { v: 'Ainda não sei', t: 'Ainda não sei' },
      ].map((p) => (
        <label class="inline-flex items-start gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
          <input type="radio" name="plano" value={p.v} required class={`${radioCls} mt-0.5`} />
          <span>{p.t}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> Campos obrigatórios</p>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
      Submeter Formulário
    </button>
    <p id="form-skin-call-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { validateRequiredFields, scrollFormIntoView } from '../../lib/form-utils';

  const form = document.getElementById('form-skin-call') as HTMLFormElement | null;
  const status = document.getElementById('form-skin-call-status');

  const SUCCESS = 'Enviado! Verifica o teu email — vou enviar-te o link privado para o diagnóstico de pele.';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateRequiredFields(form)) {
      scrollFormIntoView(form);
      return;
    }

    status.textContent = 'A enviar...';
    status.className = 'mt-3 text-sm text-darkbrown/60';

    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    })
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          status.textContent = SUCCESS;
          status.className = 'mt-3 text-sm font-medium text-burgundy';
          form.reset();
        } else {
          throw new Error(data.error || 'Erro ao enviar');
        }
      })
      .catch((err) => {
        const msg = err?.message === 'Erro ao enviar'
          ? 'Algo correu mal. Tenta novamente ou escreve para hello@marianapita.pt.'
          : err?.message || 'Algo correu mal. Tenta novamente.';
        status.textContent = msg;
        status.className = 'mt-3 text-sm text-red-700';
      });
  });
</script>