---
const inputCls =
  'mt-1 w-full border border-darkbrown/20 rounded-sm px-4 py-3 bg-white focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
const radioCls = 'accent-burgundy';
---

<form id="form-skin-call" action="/api/lead" method="POST" novalidate class="grid gap-6">
  <input type="hidden" name="form_type" value="skin-call" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid sm:grid-cols-2 gap-x-32 gap-y-6">
    <div class="flex flex-col gap-6">
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class={labelCls} for="sc-name">Nome completo <span class="text-burgundy">*</span></label>
          <input id="sc-name" name="nome" type="text" required class={inputCls} />
        </div>
        <div>
          <label class={labelCls} for="sc-phone">Contacto telefónico <span class="text-burgundy">*</span></label>
          <input id="sc-phone" name="telefone" type="tel" required class={inputCls} />
        </div>
      </div>

      <div>
        <label class={labelCls} for="sc-email">E-mail <span class="text-burgundy">*</span></label>
        <input id="sc-email" name="email" type="email" required class={inputCls} />
      </div>

      <fieldset>
        <legend class={labelCls}>Qual o plano que procuras? <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {[
            { v: 'One Time Call (Plano 3M)', t: 'One Time Call - Plano 3M' },
            { v: 'Duo Call (Plano 6M)', t: 'Duo Call - Plano 6M' },
            { v: 'Triple Call (Plano 9M)', t: 'Triple Call - Plano 9M' },
            { v: 'Full Year Call (Plano 12M)', t: 'Full Year Call - Plano 12M' },
            { v: 'Ainda não sei', t: 'Ainda não sei' },
          ].map((p) => (
            <label class="inline-flex items-start gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
              <input type="radio" name="plano" value={p.v} required class={`${radioCls} mt-0.5`} />
              <span>{p.t}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div>
        <label class={labelCls} for="sc-rotina">Descreve a tua rotina de pele atual <span class="text-burgundy">*</span></label>
        <textarea id="sc-rotina" name="rotina" required rows={4} class={inputCls} placeholder="Ex.: de manhã lavo com gel, hidratante e protetor solar; à noite remover maquilhagem e creme noturno." />
      </div>

      <fieldset>
        <legend class={labelCls}>Com que regularidade segues essa rotina? <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {[
            'Quase todos os dias',
            '2-3 vezes por semana',
            'Só quando me lembro',
            'Ainda não tenho rotina',
          ].map((o) => (
            <label class="inline-flex items-start gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
              <input type="radio" name="rotina_frequencia" value={o} required class={`${radioCls} mt-0.5`} />
              <span>{o}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="flex flex-col gap-6">
      <fieldset>
        <legend class={labelCls}>Como sentes a tua pele? <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {[
            'Normal',
            'Oleosa',
            'Seca',
            'Mista',
            'Sensível / reativa',
          ].map((o) => (
            <label class="inline-flex items-start gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
              <input type="checkbox" name="pele_tipo" value={o} class={`${radioCls} mt-0.5`} />
              <span>{o}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class={labelCls}>Quais as principais preocupações de pele? <span class="text-burgundy">*</span></legend>
        <div class="grid gap-2 mt-3">
          {[
            'Borbulhas persistentes',
            'Pigmentação / manchas',
            'Sinais de envelhecimento',
            'Vermelhidão / sensibilidade',
            'Desidratação',
            'Luminosidade',
            'Textura',
            'Olheiras',
            'Pontos negros / filamentos sebáceos',
            'Outra',
          ].map((o) => (
            <label class="inline-flex items-start gap-3 text-sm bg-white border border-darkbrown/10 rounded-sm px-4 py-3">
              <input type="checkbox" name="preocupacoes" value={o} class={`${radioCls} mt-0.5`} />
              <span>{o}</span>
            </label>
          ))}
        </div>
        <div id="preocupacoes-outro-wrap" class="hidden mt-2">
          <input type="text" name="preocupacoes_outro" placeholder="Escreve aqui..." class={inputCls} />
        </div>
      </fieldset>
    </div>
  </div>

  <p class="text-xs text-darkbrown/60"><span class="text-burgundy">*</span> Campos obrigatórios</p>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="bg-burgundy text-offwhite px-8 py-3.5 text-sm font-semibold rounded-full hover:opacity-90 transition">
      Pedir Orçamento
    </button>
    <p id="form-skin-call-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { validateRequiredFields, scrollFormIntoView } from '../../lib/form-utils';

  const form = document.getElementById('form-skin-call') as HTMLFormElement | null;
  const status = document.getElementById('form-skin-call-status');

  const outroWrap = document.getElementById('preocupacoes-outro-wrap');
  const outroInput = outroWrap?.querySelector('input') as HTMLInputElement | null;

  form?.querySelectorAll('input[name="preocupacoes"]').forEach((cb) => {
    cb.addEventListener('change', () => {
      const checked = form.querySelectorAll('input[name="preocupacoes"]:checked');
      const hasOutro = Array.from(checked).some((c) => (c as HTMLInputElement).value === 'Outra');
      outroWrap?.classList.toggle('hidden', !hasOutro);
      if (!hasOutro && outroInput) outroInput.value = '';
    });
  });

  const SUCCESS = 'Pedido enviado! Vou analisar e entrar em contacto com um orçamento.';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateRequiredFields(form)) {
      scrollFormIntoView(form);
      return;
    }

    status.textContent = 'A enviar...';
    status.className = 'mt-3 text-sm text-darkbrown/60';

    fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    })
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          status.textContent = SUCCESS;
          status.className = 'mt-3 text-sm font-medium text-burgundy';
          form.reset();
        } else {
          throw new Error(data.error || 'Erro ao enviar');
        }
      })
      .catch((err) => {
        const ownerEmail = import.meta.env.PUBLIC_OWNER_EMAIL || 'hello@marianapita.pt';
        const msg = err?.message === 'Erro ao enviar'
          ? `Algo correu mal. Tenta novamente ou escreve para ${ownerEmail}.`
          : err?.message || 'Algo correu mal. Tenta novamente.';
        status.textContent = msg;
        status.className = 'mt-3 text-sm text-red-700';
      });
  });
</script>