---
import { copy, type Locale } from '../../i18n';

interface Props {
  id: string;
  locale: Locale;
  label: string;
}

const { id, locale, label } = Astro.props;
const v = copy(locale).forms.validation;
const fieldCls =
  'border border-powder/40 rounded-sm px-4 py-3 bg-powder/40 focus:border-burgundy outline-none';
const labelCls = 'block text-sm font-medium text-darkbrown';
---

<div class="phone-field" data-phone-field data-dial-iso="PT" data-dial-code="+351" data-locale={locale}>
  <label class={labelCls} for={`${id}-number`}>{label} <span class="text-burgundy">*</span></label>
  <div class="mt-1 flex gap-2">
    <div class="relative shrink-0">
      <button
        type="button"
        id={`${id}-dial`}
        data-dial-trigger
        class={`${fieldCls} inline-flex items-center gap-2 min-w-[7.5rem]`}
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={`${id}-dial-list`}
      >
        <span data-dial-iso class="tracking-wide">PT</span>
        <span data-dial-code-label class="font-semibold">+351</span>
        <span class="text-darkbrown/50 text-xs" aria-hidden="true">▾</span>
      </button>
      <div
        data-dial-panel
        hidden
        class="absolute z-30 mt-1 w-72 max-w-[min(18rem,calc(100vw-2rem))] border border-powder/40 rounded-sm bg-offwhite shadow-md"
      >
        <input
          type="search"
          data-dial-search
          class="w-full border-0 border-b border-powder/40 rounded-none px-3 py-2 text-sm bg-transparent outline-none focus:border-burgundy"
          placeholder={v.dialSearch}
          autocomplete="off"
        />
        <ul
          id={`${id}-dial-list`}
          role="listbox"
          data-dial-list
          class="max-h-56 overflow-auto py-1"
        ></ul>
      </div>
    </div>
    <input
      id={`${id}-number`}
      type="tel"
      inputmode="numeric"
      autocomplete="tel-national"
      data-phone-number
      class={`min-w-0 flex-1 ${fieldCls}`}
    />
  </div>
  <input type="hidden" name="telefone" value="" data-phone-hidden />
</div>

<script>
  import { initPhoneFields } from '../../lib/phone-field';
  initPhoneFields();
</script>
