---
const navItems = [
  { label: 'Meet Mariana', href: '/sobre' },
  { label: 'Bridal & Beauty', href: '/servicos/bridal' },
  { label: 'The Skin Call', href: '/servicos/skin-call' },
  { label: 'Beauty Education', href: '/servicos/education' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === '/';
---

<header class="fixed top-0 left-0 right-0 z-50 header-scroll" id="site-header">
  <div class="max-w-container mx-auto px-6 md:px-16 flex items-center justify-between h-20">
    <a href="/" class="font-script text-4xl header-text">
Mariana Pita
      </a>

    <nav class="hidden lg:flex items-center gap-7">
      {navItems.map((item) => (
<a
          href={item.href}
          class:list={[
            'text-xs font-semibold uppercase tracking-wide header-text hover:text-powder transition-colors pb-1 border-b-2 border-transparent hover:border-powder',
            currentPath === item.href && '!border-powder !text-powder',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4 lg:hidden">
      <button
        id="menu-toggle"
        class="header-text"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile full-screen -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden fixed inset-0 bg-offwhite z-40 flex-col items-center justify-center gap-7"
  >
    {navItems.map((item) => (
      <a href={item.href} class="text-2xl font-display text-darkbrown hover:text-burgundy">
        {item.label}
      </a>
    ))}
  </div>
</header>

<style>
  /* Header transparente sobre o hero, sólido depois de scroll */
  .header-text {
    color: #FFFDF7;
  }
  .header-scroll {
    transition: background-color 0.3s ease;
  }
  .header-scroll.scrolled,
  .header-scroll.solid {
    background-color: #59010B;
  }
  :global(body) {
    padding-top: 0;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  // Nas páginas que não começam com hero full-bleed escuro, o header fica sempre sólido.
  const bodyHasHero = document.body.dataset.hero === 'true';

  if (!bodyHasHero) {
    header?.classList.add('solid');
  }

  window.addEventListener('scroll', () => {
    if (!bodyHasHero) return;
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  let open = false;
  toggle?.addEventListener('click', () => {
    open = !open;
    mobileMenu?.classList.toggle('hidden', !open);
    mobileMenu?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>