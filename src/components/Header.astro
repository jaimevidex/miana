---
const navItems = [
  { label: 'Sobre', href: '/sobre' },
  { label: 'Portfólio', href: '/portfolio' },
  { label: 'Serviços', href: '/servicos' },
  { label: 'Contacto', href: '/contacto' },
];
const currentPath = Astro.url.pathname;
---

<header class="absolute top-0 left-0 right-0 z-50 header-scroll" id="site-header">
  <div class="max-w-container mx-auto px-6 md:px-16 flex items-center justify-between h-20">
    <a href="/" class="font-display italic text-2xl text-creme header-text">
      [Nome]
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium header-text hover:text-ouro transition-colors',
            currentPath === item.href && 'text-ouro',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contacto"
        class="text-sm font-semibold bg-vinho text-creme px-5 py-2.5 rounded-sm hover:bg-opacity-90 transition"
      >
        Pedir orçamento
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden header-text"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Menu mobile full-screen -->
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-0 bg-espresso z-40 flex-col items-center justify-center gap-8"
  >
    {navItems.map((item) => (
      <a href={item.href} class="text-2xl font-display text-creme">
        {item.label}
      </a>
    ))}
    <a href="/contacto" class="text-sm font-semibold bg-vinho text-creme px-6 py-3 rounded-sm mt-4">
      Pedir orçamento
    </a>
  </div>
</header>

<style>
  /* Header transparente sobre o hero, sólido depois de scroll */
  .header-text {
    color: #F7F2EC;
  }
  .header-scroll {
    transition: background-color 0.3s ease;
  }
  .header-scroll.scrolled {
    background-color: #2B1F1C;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  let open = false;
  toggle?.addEventListener('click', () => {
    open = !open;
    mobileMenu?.classList.toggle('hidden', !open);
    mobileMenu?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
