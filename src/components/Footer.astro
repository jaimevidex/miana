---
const year = new Date().getFullYear();
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Meet Mariana', href: '/sobre' },
  { label: 'Bridal & Beauty', href: '/servicos/bridal' },
  { label: 'The Skin Call', href: '/servicos/skin-call' },
  { label: 'Beauty Education', href: '/servicos/education' },
];
---

<footer class="bg-burgundy text-offwhite">
  <div class="max-w-container mx-auto px-6 py-16 md:px-16 flex flex-col items-start gap-12 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-script text-4xl mb-3">Mariana Pita</p>
      <p class="text-sm text-offwhite/70 max-w-xs">
        Science-Led Skincare &amp; Effortless Beauty
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8">
      <nav class="flex flex-col gap-3">
        <span class="eyebrow !text-white mb-1">Navegação</span>
        {navItems.map((item) => (
          <a href={item.href} class="text-sm text-offwhite/80 hover:text-powder">{item.label}</a>
        ))}
      </nav>

      <div class="flex flex-col gap-3">
        <span class="eyebrow !text-white mb-1">Contacto</span>
        <a href="mailto:hello@marianapita.pt" class="text-sm text-offwhite/80 hover:text-powder">
          hello@marianapita.pt
        </a>
        <a href="https://instagram.com/bymarianapita" target="_blank" rel="noopener" class="text-sm text-offwhite/80 hover:text-powder">
          @bymarianapita
        </a>
        <p class="text-sm text-offwhite/60">Lisboa &amp; Santarém</p>
      </div>
    </div>
  </div>

  <div class="border-t border-offwhite/10 py-6 text-center text-xs text-offwhite/50">
    <p>© {year} MARIANA. Todos os direitos reservados.</p>
    <p class="mt-2"><a href="/politica-privacidade" class="underline hover:text-powder">Política de Privacidade &amp; Cookies (RGPD)</a></p>
  </div>
</footer>