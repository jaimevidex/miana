---
const year = new Date().getFullYear();
const navItems = [
  { label: 'Sobre', href: '/sobre' },
  { label: 'Portfólio', href: '/portfolio' },
  { label: 'Serviços', href: '/servicos' },
  { label: 'Contacto', href: '/contacto' },
];
---

<footer class="bg-espresso text-creme">
  <div class="max-w-container mx-auto px-6 md:px-16 py-16 grid gap-12 md:grid-cols-3">
    <div>
      <p class="font-display italic text-2xl mb-3">[Nome]</p>
      <p class="text-argila text-sm max-w-xs">
        <!-- TODO: tagline curta, ver docs/CONTENT.md -->
        Maquilhagem profissional para o dia mais importante — e para todos os outros.
      </p>
    </div>

    <nav class="flex flex-col gap-3">
      <span class="eyebrow text-ouro mb-1">Navegação</span>
      {navItems.map((item) => (
        <a href={item.href} class="text-sm text-creme/80 hover:text-ouro">{item.label}</a>
      ))}
    </nav>

    <div class="flex flex-col gap-3">
      <span class="eyebrow text-ouro mb-1">Contacto</span>
      <a href="mailto:ola@exemplo-maquilhadora.pt" class="text-sm text-creme/80 hover:text-ouro">
        ola@exemplo-maquilhadora.pt
      </a>
      <div class="flex gap-4 mt-2">
        <a href="#" aria-label="Instagram" class="text-creme/80 hover:text-ouro">Instagram</a>
        <a href="#" aria-label="WhatsApp" class="text-creme/80 hover:text-ouro">WhatsApp</a>
      </div>
    </div>
  </div>

  <div class="border-t border-creme/10 py-6 text-center text-xs text-argila">
    © {year} [Nome]. Todos os direitos reservados.
  </div>
</footer>
