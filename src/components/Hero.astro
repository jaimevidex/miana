---
// Substituir o placeholder por <Image> de astro:assets quando a foto real existir.
// import { Image } from 'astro:assets';
// import heroImg from '../../public/images/hero.jpg';
---

<section class="relative h-screen min-h-[640px] flex items-end overflow-hidden">
  <!-- Placeholder de imagem — substituir por foto real de alta resolução (ver docs/IMAGES.md) -->
  <div class="absolute inset-0 hero-placeholder"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-espresso/90 via-espresso/20 to-espresso/40"></div>

  <div class="relative z-10 max-w-container mx-auto w-full px-6 md:px-16 pb-28">
    <p class="eyebrow text-ouro mb-4 reveal">Maquilhagem profissional</p>
    <h1 class="text-display-l md:text-display-xl italic text-creme max-w-2xl reveal">
      Maquilhagem que revela, não disfarça.
    </h1>
    <p class="text-creme/85 text-lg mt-6 max-w-md reveal">
      <!-- TODO: subheadline real, ver docs/CONTENT.md -->
      Sessões pensadas para realçar a tua própria beleza, do civil ao grande dia.
    </p>
    <div class="flex gap-4 mt-8 reveal">
      <a href="/portfolio" class="bg-vinho text-creme px-6 py-3 text-sm font-semibold rounded-sm hover:bg-opacity-90 transition">
        Ver portfólio
      </a>
      <a href="/contacto" class="border border-creme/40 text-creme px-6 py-3 text-sm font-semibold rounded-sm hover:border-ouro hover:text-ouro transition">
        Pedir orçamento
      </a>
    </div>
  </div>
</section>

<style>
  /* Placeholder visual enquanto não há foto real — substituir por <Image> */
  .hero-placeholder {
    background: linear-gradient(135deg, #3a2a25 0%, #2b1f1c 45%, #4a2f36 100%);
  }
</style>
