---
// Imagem de fundo: substituir o placeholder por <Image> de astro:assets quando a foto real existir
// (retrato "Sessão de Lisboa" — ver docs/IMAGES.md e docs/PLAN.md fase deferred).
const {
  eyebrow = 'Healthy Skin, Makeup that makes you glow',
  title = 'Skincare & Makeup',
  sub = 'Where skin science meets beauty. Maquilhagem que realça a tua beleza natural e uma rotina de skincare desenhada à medida da tua pele.',
} = Astro.props;
---

<section id="inicio" class="relative h-screen min-h-[640px] flex items-center overflow-hidden">
  <div class="absolute inset-0 hero-placeholder"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-darkbrown/90 via-darkbrown/30 to-darkbrown/40"></div>

  <div class="relative z-10 max-w-container mx-auto w-full px-6 md:px-16 text-center">
    <p class="eyebrow !text-offwhite mb-4 reveal">{eyebrow}</p>
    <h1 class="mx-auto text-2xl md:text-display-xl font-display font-bold text-offwhite whitespace-nowrap reveal">
      {title}
    </h1>
    <p class="text-offwhite/85 text-base mt-5 max-w-xl mx-auto reveal">{sub}</p>
  </div>
</section>

<style>
  .hero-placeholder {
    background: linear-gradient(135deg, #7a2430 0%, #59010b 50%, #2d1918 100%);
  }
</style>