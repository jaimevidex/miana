---
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title?: string;
  sub?: string;
  image?: string | ImageMetadata;
  video?: Array<{ src: string; type: string }>;
  poster?: string;
  imgClass?: string;
  imgStyle?: string;
}

const {
  eyebrow = 'Healthy Skin, Makeup that makes you glow',
  title = 'Skincare & Makeup',
  sub = 'Where skin science meets beauty. Maquilhagem que realça a tua beleza natural e uma rotina de skincare desenhada à medida da tua pele.',
  image,
  video,
  poster,
  imgClass = '',
  imgStyle = '',
} = Astro.props;

const imgClasses = `absolute inset-0 h-[140%] -top-[40%] w-full object-cover ${imgClass}`;
---

<section id="inicio" class="relative h-screen min-h-[640px] flex items-center overflow-hidden">
  {
    video && video.length ? (
      <video
        class="absolute inset-0 h-[100%] -top-[0%] w-full object-cover"
        muted
        loop
        playsinline
        preload="none"
        data-hero-video
        poster={poster}
      >
        {video.map((s) => (
          <source src={s.src} type={s.type} />
        ))}
      </video>
    ) : image ? (
      typeof image === 'string' ? (
        <img
          src={image}
          alt={eyebrow}
          loading="eager"
          fetchpriority="high"
          class={imgClasses}
          style={imgStyle}
        />
      ) : (
        <div class="absolute inset-0">
          <Image
            src={image}
            alt={eyebrow}
            loading="eager"
            fetchpriority="high"
            quality={90}
            class={`absolute inset-0 h-[140%] -top-[40%] w-full object-cover ${imgClass}`}
            style={imgStyle}
          />
        </div>
      )
    ) : (
      <div class="absolute inset-0 hero-placeholder"></div>
    )
  }
  <div class="absolute inset-0 bg-gradient-to-t from-darkbrown/90 via-darkbrown/30 to-darkbrown/40"></div>

  <div class="relative z-10 max-w-container mx-auto w-full px-6 md:px-16 text-center">
    <p class="eyebrow !text-offwhite mb-4 reveal">{eyebrow}</p>
    <h1 class="mx-auto text-5xl md:text-display-2xl font-display font-bold text-offwhite md:whitespace-nowrap reveal">
      {title}
    </h1>
    <p class="text-offwhite/85 text-base mt-5 max-w-xl mx-auto reveal">{sub}</p>
  </div>
</section>

<style>
  .hero-placeholder {
    background: linear-gradient(135deg, #7a2430 0%, #59010b 50%, #2d1918 100%);
  }
</style>

<script>
  // Defer hero video: load after page is interactive, not on initial parse
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (heroVideo) {
    let loaded = false;
    const loadHero = () => {
      if (loaded) return;
      loaded = true;
      heroVideo.preload = 'auto';
      heroVideo.load();
      heroVideo.play?.().catch(() => {});
    };
    // Load after 1.5s or on first user interaction — whichever comes first
    const timer = window.setTimeout(loadHero, 1500);
    ['scroll', 'mousemove', 'touchstart'].forEach((evt) => {
      window.addEventListener(
        evt,
        () => {
          clearTimeout(timer);
          loadHero();
        },
        { once: true, passive: true }
      );
    });
  }
</script>