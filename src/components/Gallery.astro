---
// Galeria reutilizável. Imagens reais a entregar (ver docs/IMAGES.md) —
// atualmente placeholders de cor por categoria, prontos a substituir por <Image> de astro:assets.

interface Item {
  category: string;
  alt: string;
  tall?: boolean;
}

interface Props {
  items?: Item[];
  showFilters?: boolean;
  /** Padrão "tijolo": alturas variadas, com topo e fundo alinhados. */
  brick?: boolean;
}

const defaultItems: Item[] = [
  { category: 'Noivas', alt: 'Maquilhagem de noiva com acabamento luminoso e natural', tall: true },
  { category: 'Beauty', alt: 'Look editorial glowy e sunkissed' },
  { category: 'Workshops', alt: 'Workshop de automaquilhagem em grupo', tall: true },
  { category: 'Skincare', alt: 'Rotina de skincare personalizada' },
  { category: 'Noivas', alt: 'Detalhe do glow de pele num dia de casamento' },
  { category: 'Beauty', alt: 'Retrato elegante de maquilhagem premium', tall: true },
  { category: 'Workshops', alt: 'Sessão 1:1 de automaquilhagem' },
  { category: 'Skincare', alt: 'Análise de pele e produtos de skincare', tall: true },
  { category: 'Noivas', alt: 'Celebração final de um grande dia com glow natural', tall: true },
  { category: 'Beauty', alt: 'Pormenor de maquilhagem editorial com brilho' },
];

const { items = defaultItems, showFilters = true, brick = false } = Astro.props;
const categories = ['Todos', ...new Set(items.map((i) => i.category))];
// Modo "brick": masonry retrato em 3 colunas de igual altura (fundo reto).
// Cada coluna recebe a mesma quantidade de cada ratio (1 quadrado, 1 2:3, 1 4:5), mas por ordem
// diferente — parecer aleatório, mas a soma de alturas + espaços é idêntica → as 3 fecham reto.
const RATIOS = ['aspect-square', 'aspect-[2/3]', 'aspect-[4/5]'];
const ratioWeight: Record<string, number> = {
  'aspect-square': 1,
  'aspect-[2/3]': 1.5,
  'aspect-[4/5]': 1.25,
};
// Espaço vertical entre peças, em fração da largura da coluna (gap-[3%]).
const GAP = 0.03;
const shuffled = (arr: typeof items) =>
  arr
    .map((v, i) => ({ v, k: (i * 7 + 3) % 13 }))
    .sort((a, b) => a.k - b.k)
    .map((x) => x.v);

const COLS = 3;
const perCol = Math.floor(items.length / COLS);
const brickItems = shuffled(items.slice(0, COLS * perCol));
// Distribui as imagens em round-robin pelas colunas e roda os ratios por coluna (ordens diferentes).
const brickColumns = Array.from({ length: COLS }, (_, c) =>
  Array.from({ length: perCol }, (_, r) => {
    const item = brickItems[r * COLS + c];
    const ratio = RATIOS[(r + c) % RATIOS.length];
    return { item, ratio, weight: ratioWeight[ratio] };
  })
);

const toneByCategory: Record<string, string> = {
  Noivas: 'linear-gradient(160deg, #FFF1EC 0%, #F3D9C8 60%, #C89B7A 100%)',
  Beauty: 'linear-gradient(160deg, #FBEDF0 0%, #E5C1C8 55%, #A97B86 100%)',
  'Bridal Party': 'linear-gradient(160deg, #F7E8F2 0%, #E3C2D1 55%, #B07F96 100%)',
  Workshops: 'linear-gradient(160deg, #F4EFFB 0%, #D6C9EC 55%, #9B86C4 100%)',
  Skincare: 'linear-gradient(160deg, #EAF4FA 0%, #C6E0F0 55%, #8FB8D8 100%)',
};
---

<div>
  {showFilters && (
    <div class="flex flex-wrap gap-3 justify-center mb-10" id="gallery-filters">
      {categories.map((cat, i) => (
        <button
          class:list={[
            'text-sm px-4 py-2 rounded-full border transition',
            i === 0 ? 'bg-burgundy text-offwhite border-burgundy' : 'border-darkbrown/25 text-darkbrown/70 hover:border-burgundy hover:text-burgundy',
          ]}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>
  )}

  {brick ? (
    <>
      <div class="columns-1 sm:columns-2 lg:hidden gap-3 sm:gap-4 space-y-3 sm:space-y-4" id="gallery-grid">
        {items.map((item) => (
          <button
            class="gallery-item block w-full break-inside-avoid relative overflow-hidden rounded-sm group"
            data-category={item.category}
            aria-label={`Ver ${item.alt} em tamanho maior`}
          >
            <div
              class:list={[
                'gallery-placeholder w-full',
                item.tall ? 'aspect-[4/5]' : 'aspect-square',
              ]}
              style={`background:${toneByCategory[item.category] ?? '#EFE7E0'}`}
            ></div>
            <span class="absolute inset-0 bg-burgundy/0 group-hover:bg-burgundy/5 transition-colors"></span>
            <span class="absolute bottom-3 left-3 text-[0.65rem] uppercase tracking-widest text-darkbrown/70 opacity-0 group-hover:opacity-100 transition-opacity">
              {item.category}
            </span>
          </button>
        ))}
      </div>
      <div class="hidden lg:grid grid-cols-3 gap-4 items-start" id="gallery-grid-desktop">
        {brickColumns.map((col) => (
          <div class="flex flex-col gap-4">
            {col.map((t) => (
              <button
                class="gallery-item block w-full break-inside-avoid relative overflow-hidden rounded-sm group"
                data-category={t.item.category}
                aria-label={`Ver ${t.item.alt} em tamanho maior`}
              >
                <div
                  class={`gallery-placeholder w-full ${t.ratio}`}
                  style={`background:${toneByCategory[t.item.category] ?? '#EFE7E0'}`}
                ></div>
                <span class="absolute inset-0 bg-burgundy/0 group-hover:bg-burgundy/5 transition-colors"></span>
                <span class="absolute bottom-3 left-3 text-[0.65rem] uppercase tracking-widest text-darkbrown/70 opacity-0 group-hover:opacity-100 transition-opacity">
                  {t.item.category}
                </span>
              </button>
            ))}
          </div>
        ))}
      </div>
    </>
  ) : (
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 space-y-5" id="gallery-grid">
      {items.map((item, i) => (
        <button
          class="gallery-item block w-full break-inside-avoid relative overflow-hidden rounded-sm group"
          data-category={item.category}
          aria-label={`Ver ${item.alt} em tamanho maior`}
        >
          <div
            class:list={[
              'gallery-placeholder w-full',
              item.tall ? 'aspect-[4/5]' : 'aspect-square',
            ]}
            style={`background:${toneByCategory[item.category] ?? '#EFE7E0'}`}
          ></div>
          <span class="absolute inset-0 bg-burgundy/0 group-hover:bg-burgundy/5 transition-colors"></span>
          <span class="absolute bottom-3 left-3 text-[0.65rem] uppercase tracking-widest text-darkbrown/70 opacity-0 group-hover:opacity-100 transition-opacity">
            {item.category}
          </span>
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .gallery-placeholder {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gallery-item:hover .gallery-placeholder {
    transform: scale(1.03);
  }
</style>

<script>
  const buttons = document.querySelectorAll('#gallery-filters button');
  const items = document.querySelectorAll('.gallery-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('bg-burgundy', 'text-offwhite', 'border-burgundy');
        b.classList.add('border-darkbrown/25', 'text-darkbrown/70');
      });
      btn.classList.add('bg-burgundy', 'text-offwhite', 'border-burgundy');

      const filter = btn.getAttribute('data-filter');
      items.forEach((item) => {
        const show = filter === 'Todos' || item.getAttribute('data-category') === filter;
        (item as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>
