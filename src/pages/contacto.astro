---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
---

<Layout title="Contacto — Mariana | Science-Led Skincare & Effortless Beauty" description="Entra em contacto com a Mariana. Responde em até 48h. E-mail, Instagram e formulário de contacto para agendar a tua consultoria, maquilhagem ou workshop.">
  <section id="contacto" class="pt-32 pb-24 max-w-container mx-auto px-6 md:px-16">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">Contacto</p>
        <h1 class="text-display-l italic mb-6 reveal">Let's book your glow</h1>
        <p class="text-darkbrown/70 mb-10 reveal">
          Preenche o formulário com os detalhes da tua consultoria, maquilhagem ou workshop e
          respondo em até 48h com todas as informações.
        </p>

        <div class="space-y-4 text-sm">
          <p>
            <span class="text-darkbrown/60">E-mail:</span>
            <a href="mailto:mpitamakeup@gmail.com" class="text-burgundy hover:underline">mpitamakeup@gmail.com</a>
          </p>
          <p>
            <span class="text-darkbrown/60">Instagram:</span>
            <a href="https://instagram.com/marianapita_makeup" target="_blank" rel="noopener" class="text-burgundy hover:underline">@marianapita_makeup</a>
          </p>
          <p class="text-darkbrown/60">Atendimento presencial / on location &amp; consultorias online · Lisboa &amp; Santarém</p>
        </div>
      </div>

      <ContactForm />
    </div>
  </section>
</Layout>