---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SwatchDivider from '../components/SwatchDivider.astro';
import Gallery from '../components/Gallery.astro';

const servicos = [
  { title: 'Noivas', desc: 'Prova + dia do casamento, maquilhagem que dura o dia todo.' },
  { title: 'Editorial', desc: 'Para produções fotográficas, campanhas e moda.' },
  { title: 'Dia-a-dia', desc: 'Looks naturais para o quotidiano ou eventos casuais.' },
];
---

<Layout
  title="[Nome] — Maquilhagem Profissional"
  description="Maquilhagem profissional para noivas, editorial e dia-a-dia. Marca já a tua sessão."
>
  <Hero />

  <SwatchDivider />

  <section class="max-w-container mx-auto px-6 md:px-16 py-24 text-center">
    <p class="eyebrow mb-4">Sobre</p>
    <h2 class="text-display-l italic max-w-2xl mx-auto reveal">
      <!-- TODO: substituir por texto real, docs/CONTENT.md -->
      Cada rosto tem a sua própria paleta — o meu trabalho é encontrá-la.
    </h2>
    <p class="text-argila mt-6 max-w-xl mx-auto reveal">
      Com anos de experiência em noivas, editorial e produções fotográficas, trago uma
      abordagem cuidada e pessoal a cada sessão.
    </p>
    <a href="/sobre" class="inline-block mt-8 text-vinho font-semibold text-sm hover:underline">
      Conhecer a minha história →
    </a>
  </section>

  <section class="bg-espresso text-creme py-24">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <p class="eyebrow text-ouro mb-4 text-center">Portfólio</p>
      <h2 class="text-display-l italic text-center mb-14 reveal">Trabalhos recentes</h2>
      <Gallery showFilters={false} />
      <div class="text-center mt-12">
        <a href="/portfolio" class="border border-creme/40 text-creme px-6 py-3 text-sm font-semibold rounded-sm hover:border-ouro hover:text-ouro transition">
          Ver portfólio completo
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-container mx-auto px-6 md:px-16 py-24">
    <p class="eyebrow text-center mb-4">Serviços</p>
    <h2 class="text-display-l italic text-center mb-14 reveal">O que faço</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {servicos.map((s) => (
        <div class="border border-argila/20 rounded-sm p-8 reveal">
          <h3 class="text-display-m italic mb-3">{s.title}</h3>
          <p class="text-argila text-sm">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-vinho text-creme py-20 text-center">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <h2 class="text-display-l italic mb-6 reveal">Vamos criar o teu look?</h2>
      <a href="/contacto" class="inline-block bg-creme text-vinho px-8 py-4 text-sm font-semibold rounded-sm hover:bg-opacity-90 transition">
        Pedir orçamento
      </a>
    </div>
  </section>
</Layout>
