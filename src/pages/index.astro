---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const servicos = [
  {
    titulo: 'Bridal & Beauty',
    desc: 'Maquilhagem luminosa e sunkissed, desenhada à tua medida para os momentos mais especiais.',
    href: '/servicos/bridal',
    image: '/images/home-bridal.jpg',
  },
  {
    titulo: 'The Skin Call',
    desc: 'Consultoria 1:1 focada na biologia e química da tua pele. O teu plano de skincare personalizado, sem complicações.',
    href: '/servicos/skin-call',
    image: '/images/home-skin-call.jpg',
  },
  {
    titulo: 'Beauty Education',
    desc: 'Workshops e masterclasses de makeup e skincare para aprenderes a dominar a tua rotina e o teu glow.',
    href: '/servicos/education',
    image: '/images/home-education.jpg',
  },
];

const testemunhos = [
  {
    texto: 'A makeup ficou simplesmente sensacional! A Mariana tem um talento enorme e adorei, acima de tudo, o cuidado, o carinho e a atenção que tem para com cada pessoa. Senti-me mesmo especial. Recomendo de coração!',
    autor: 'Joana',
  },
  {
    texto: 'Conheci a Mariana ainda durante o seu curso, fui modelo dela! E adivinhem? Adorei!!!! No último casamento que tive foi ela quem me maquilhou a mim, a minha irmã e a minha mãe e ficámos todas lindas! Obrigada!!',
    autor: 'Rita',
  },
  {
    texto: 'Fui maquilhada pela Mariana para o meu casamento e foi incrível! Fizemos a prova e, no dia do casamento, dei feedback do que queria alterar, e essas alterações foram executadas na perfeição.',
    autor: 'Dhara',
  },
  {
    texto: 'Trabalhar com a Mariana foi 10000/10. Para além da makeup incrível, a melhor parte foi a simpatia, pontualidade e cuidado enquanto estava a maquilhar. Não é "maquilho e pronto". Nota-se o cuidado com o conforto das clientes, que podem sentir-se bem em dar a sua opinião!',
    autor: 'Adriana',
  },
  {
    texto: 'Estou muito satisfeita com os produtos que a Mariana me aconselhou para a minha pele. Estou a adorar... A minha pele nunca esteve tão bem. Muito grata, adorei.',
    autor: 'Liliana',
  },
  {
    texto: 'Se procuram um aconselhamento de skincare personalizado e baseado em conhecimento científico, para perceberem o que a vossa pele realmente precisa, recomendo mesmo a Mariana! Ajudou-me a perceber as necessidades da minha pele e, desde que comecei a seguir a rotina, notei uma diferença enorme: os poros diminuíram drasticamente, a oleosidade na zona T está mais controlada e a minha pele está muito mais luminosa.',
    autor: 'Daniela',
  },
];
---

<Layout title="Mariana — Science-Led Skincare & Effortless Beauty" description="Unimos a ciência da pele à arte da maquilhagem. Rituais de skincare personalizados e maquilhagem glowy e sunkissed para noivas, eventos e educação." hasHero>
  <Hero image="/images/hero-home.jpg" />

  <section id="filosofia" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="max-w-2xl mx-auto text-center reveal">
      <p class="text-lg md:text-xl leading-relaxed text-darkbrown/85">
        Acreditamos que a verdadeira beleza começa na saúde da pele. Guiada pela ciência da
        Bioquímica e da Cosmetologia, a nossa filosofia rejeita o excesso de produtos e as
        tendências. Descomplicamos a química do skincare para entregar rituais personalizados e
        criar a tela ideal para uma maquilhagem luminosa, sunkissed e pensada para realçar a tua
        beleza natural. Um glow que te faz sentir tu própria, effortlessly.
      </p>
      <a href="/sobre" class="inline-block mt-8 text-burgundy font-semibold text-sm underline-offset-4 hover:underline">
        Meet Mariana →
      </a>
    </div>
  </section>

  <section id="servicos" class="max-w-container mx-auto px-6 md:px-16 pb-8 md:pb-12">
    <h2 class="text-display-l font-bold text-center text-burgundy mb-12 reveal">O Que Fazemos</h2>
    <div class="grid md:grid-cols-3 gap-6 md:gap-8 max-w-md md:max-w-none mx-auto">
      {servicos.map((s, i) => (
        <a href={s.href} class="group relative block rounded-sm overflow-hidden reveal border border-darkbrown/10 hover:border-burgundy/40 transition">
          <div class="relative aspect-[1/1] md:aspect-[3/4] w-full overflow-hidden">
            <img src={s.image} alt={s.titulo} loading="lazy" decoding="async"
              class="absolute inset-0 h-full w-full object-cover service-ph" />
            <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-darkbrown/70 via-transparent to-darkbrown/15">
              <div class="flex flex-col items-center text-center px-6">
                <h3 class="font-display text-4xl md:text-3xl text-offwhite leading-tight">{s.titulo}</h3>
                <span class="mt-2 text-xs uppercase tracking-widest text-powder border-b border-powder/60 pb-1">Descobre mais</span>
              </div>
            </div>
          </div>
          <p class="text-darkbrown/75 text-base md:text-lg text-center leading-relaxed py-5 md:py-6 px-6">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="testemunhos" class="max-w-container mx-auto px-6 md:px-16 py-16 md:py-32">
    <h2 class="text-display-l font-bold text-center text-burgundy mb-4 reveal">What They Say</h2>
    <p class="text-darkbrown/60 text-center max-w-md mx-auto text-sm mb-12 reveal">
      As palavras de quem já passou pelo nosso cuidado.
    </p>
    <div class="testimonials relative max-w-5xl mx-auto px-10 md:px-16">
      <button type="button" aria-label="Testemunho anterior" class="t-arrow left" data-t-prev>&lsaquo;</button>
      <div class="overflow-hidden" data-t-holder>
        <div class="flex" data-t-track>
          {testemunhos.map((t) => (
            <div class="t-card shrink-0">
              <figure class="flex h-full flex-col rounded-sm border border-darkbrown/10 bg-white px-6 py-5">
                <blockquote class="text-darkbrown/80 text-sm leading-relaxed">"{t.texto}"</blockquote>
                <figcaption class="mt-4 text-burgundy font-semibold text-xs uppercase tracking-widest">— {t.autor}</figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
      <button type="button" aria-label="Próximo testemunho" class="t-arrow right" data-t-next>&rsaquo;</button>
    </div>
  </section>
</Layout>

<script>
  const track = document.querySelector('[data-t-track]') as HTMLElement;
  const nextBtn = document.querySelector('[data-t-next]') as HTMLButtonElement;
  const prevBtn = document.querySelector('[data-t-prev]') as HTMLButtonElement;

  // Cards reais antes de duplicar.
  const originals = Array.from(track.children) as HTMLElement[];
  const n = originals.length;

  // Duplica para loop infinito suave: [último] + originais + [primeiros].
  const clone = (els: HTMLElement[]) => els.map((c) => c.cloneNode(true) as HTMLElement);
  clone(originals.slice(-1)).forEach((el) => track.prepend(el));
  clone(originals.slice(0, n)).forEach((el) => track.appendChild(el));

  // Todos os cards do track. Depois do prepend, os originais ficam em all[1..n].
  const all = Array.from(track.children) as HTMLElement[];
  const realStart = all.indexOf(originals[0]); // índice do 1º original
  const perView = () => (window.matchMedia('(min-width: 768px)').matches ? 3 : 1);
  const maxStart = all.length - perView(); // último índice possível sem mostrar vazio

  // idx = índice (no track) do primeiro card VISÍVEL.
  let idx = realStart;

  // posição acumulada em px (card + respetivo gap).
  function pos(i: number): number {
    let base = 0;
    for (let k = 0; k < i; k++) {
      const w = all[k].offsetWidth;
      const next = all[k + 1];
      const gap = next ? next.offsetLeft - all[k].offsetLeft - w : 0;
      base += w + gap;
    }
    return base;
  }

  function render(animate: boolean) {
    track.style.transition = animate ? 'transform 0.55s cubic-bezier(0.4, 0, 0.2, 1)' : 'none';
    track.style.transform = `translateX(${-pos(idx)}px)`;
  }

  function jump(to: number, animate: boolean) {
    idx = to;
    if (!animate) {
      track.style.transition = 'none';
      track.style.transform = `translateX(${-pos(idx)}px)`;
    }
    requestAnimationFrame(() => render(true));
  }

  function next() {
    if (idx + 1 > maxStart) jump(realStart, false);
    else { idx += 1; render(true); }
  }

  function prev() {
    if (idx - 1 < realStart) jump(maxStart, false);
    else { idx -= 1; render(true); }
  }

  nextBtn.addEventListener('click', next);
  prevBtn.addEventListener('click', prev);
  window.addEventListener('resize', () => render(false));
  render(false);
</script>

<style>
  .testimonials .t-card {
    width: 100%;
  }
  .testimonials [data-t-track] {
    gap: 1rem;
    align-items: stretch;
  }
  @media (min-width: 768px) {
    .testimonials .t-card {
      width: calc((100% - 2rem) / 3);
    }
  }
  .testimonials .t-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    padding-bottom: 0.15em;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-offwhite, #fff);
    background: var(--color-burgundy, #59010B);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
    cursor: pointer;
    transition: opacity 0.2s ease;
    z-index: 5;
  }
  .testimonials .t-arrow:hover {
    opacity: 0.85;
  }
  .testimonials .t-arrow.left {
    left: 0;
  }
  .testimonials .t-arrow.right {
    right: 0;
  }
</style>

<style>
  .service-ph {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .group:hover .service-ph {
    transform: scale(1.03);
  }
</style>