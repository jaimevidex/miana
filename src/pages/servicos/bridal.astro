---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BridalForm from '../../components/forms/BridalForm.astro';
import Gallery from '../../components/Gallery.astro';
import GalleryMedia from '../../components/GalleryMedia.astro';
import Hero from '../../components/Hero.astro';
import Lightbox from '../../components/Lightbox.astro';

import bridalExperience from '../../assets/images/bridal-experience.jpg';
import bridalCta from '../../assets/images/bridal-cta.jpg';
import guestsEvents from '../../assets/images/guests-events.jpg';

import bridalPortfolio1 from '../../assets/images/bridal-portfolio-1.jpg';
import bridalPortfolio2 from '../../assets/images/bridal-portfolio-2.jpg';
import bridalPortfolio3 from '../../assets/images/bridal-portfolio-3.jpg';
import bridalPortfolio4 from '../../assets/images/bridal-portfolio-4.jpg';
import bridalPortfolio5 from '../../assets/images/bridal-portfolio-5.jpg';
import bridalPortfolio6 from '../../assets/images/bridal-portfolio-6.jpg';
import bridalPortfolio7 from '../../assets/images/bridal-portfolio-7.jpg';
import bridalPortfolio8 from '../../assets/images/bridal-portfolio-8.jpg';

import guestsPortfolio1 from '../../assets/images/guests-portfolio-1.jpg';
import guestsPortfolio2 from '../../assets/images/guests-portfolio-2.jpg';
import guestsPortfolio3 from '../../assets/images/guests-portfolio-3.jpg';
import guestsPortfolio4 from '../../assets/images/guests-portfolio-4.jpg';
import guestsPortfolio5 from '../../assets/images/guests-portfolio-5.jpg';
import guestsPortfolio6 from '../../assets/images/guests-portfolio-6.jpg';
import guestsPortfolio7 from '../../assets/images/guests-portfolio-7.jpg';
import guestsPortfolio8 from '../../assets/images/guests-portfolio-8.jpg';

import bridalHero from '../../assets/videos/bridal-hero.mp4';
import bridalHeroPoster from '../../assets/images/bridal-hero-poster.jpg';
import bridalPortfolioVid from '../../assets/videos/bridal-portfolio.mp4';
import guestsPortfolioVid from '../../assets/videos/guests-portfolio.mp4';

const servicos = [
  {
    num: '01',
    title: 'The Bridal Experience',
    desc: 'Weddings are all about celebrating love. E porque cada noiva é única, a tua makeup deve refletir exatamente quem és e acompanhar-te do primeiro "sim" ao último segundo da festa, sem preocupações. Conta connosco para tornar a tua preparação num momento calmo, leve e inesquecível. A nossa Bridal Experience inclui prova, a makeup no dia do casamento e um touch-up kit.',
    extra: 'Makeup | Hair | Pack Makeup + Hair',
    addon: 'Add a Skin Call: Podes adicionar um plano de skincare 1:1 nos meses anteriores para preparar a pele até ao grande dia. Inclui oferta especial.',
  },
  {
    num: '02',
    title: 'Guests & Events',
    desc: 'A special moment calls for a special glow. Glam on demand para casamentos, eventos, sessões fotográficas ou dias em que precisas simplesmente de um glow extra. Um look tailored-made para ti, com a durabilidade que precisas para aproveitar o dia ao máximo.',
    extra: 'Makeup | Hair | Pack Makeup + Hair',
  },
];

const imgStyleBridal = 'transform: scale(1.25) translateX(-18%); object-fit: cover; object-position: center; transform-origin: center left;';
const imgStyleGuests1 = 'transform: scale(1.20) translateY(7%); object-position: center;';
const imgStyleGuests2 = 'transform: scale(1.45) translateY(-7%); object-position: center;';
const imgStyleGuests3 = 'transform: scale(1.55) translateX(-10%); object-position: center;';
const imgStyleGuests4 = 'transform: scale(1.45); object-position: center;';

const galeriaBridal = [
  { category: 'Noivas', alt: 'Celebração final de um grande dia com glow natural', image: bridalPortfolio8 },
  { category: 'Noivas', alt: 'Detalhe do glow de pele em dia de casamento', video: bridalPortfolioVid },
  { category: 'Noivas', alt: 'Preparação de noiva em dia de casamento', image: bridalPortfolio3 },
  { category: 'Noivas', alt: 'Bridal glow para fotografar impecavelmente', image: bridalPortfolio4, imgStyle: imgStyleBridal },
  { category: 'Noivas', alt: 'Maquilhagem luminosa para cerimónia', image: bridalPortfolio6 },
  { category: 'Noivas', alt: 'Retrato final de noiva com glow delicado', image: bridalPortfolio5 },
  { category: 'Noivas', alt: 'Look de noiva glowy e sunkissed', image: bridalPortfolio2 },
  { category: 'Noivas', alt: 'Maquilhagem de noiva com acabamento luminoso e natural', image: bridalPortfolio1, imgStyle: imgStyleBridal },
  { category: 'Noivas', alt: 'Toque final antes da cerimónia', image: bridalPortfolio7 },
];

const galeriaGuests = [
  { category: 'Beauty', alt: 'Look editorial glowy e sunkissed', image: guestsPortfolio1 },
  { category: 'Beauty', alt: 'Glam on demand para a tua festa', video: guestsPortfolioVid },
  { category: 'Beauty', alt: 'Look para sessão fotográfica', image: guestsPortfolio7 },
  { category: 'Beauty', alt: 'Makeup para convidadas e festas em grupo', image: guestsPortfolio2, imgStyle: imgStyleGuests1 },
  { category: 'Beauty', alt: 'Maquilhagem para eventos e ocasiões especiais', image: guestsPortfolio5 },
  { category: 'Beauty', alt: 'Glow natural em look de evento', image: guestsPortfolio4, imgStyle: imgStyleGuests2 },
  { category: 'Beauty', alt: 'Acabamento luminoso para evento', image: guestsPortfolio6, imgStyle: imgStyleGuests3 },
  { category: 'Beauty', alt: 'Retrato elegante de maquilhagem premium', image: guestsPortfolio3 },
  { category: 'Beauty', alt: 'Durabilidade de make para eventos longos', image: guestsPortfolio8, imgStyle: imgStyleGuests4 },
];

const galeriaBridalCombo = [
  { category: 'Noivas', alt: 'The Bridal Experience', image: bridalExperience },
  ...galeriaBridal,
];

const galeriaGuestsCombo = [
  { category: 'Beauty', alt: 'Guests & Events', image: guestsEvents },
  ...galeriaGuests,
];
---

<Layout title="Bridal & Beauty - Mariana" description="Maquilhagem de noiva e eventos com um acabamento luminoso e sunkissed. Bridal Experience, Bridal Party & Guests, Event & Special Occasions. Makeup ou Makeup + Hair." hasHero>
  <Hero
    eyebrow="Luminous, sunkissed & effortlessly you"
    title="Bridal & Beauty"
    sub="Maquilhagem on demand desenhada à tua medida, pensada para durar o dia todo e fazer-te sentir a tua melhor versão."
    video={[{ src: bridalHero, type: 'video/mp4' }]}
    poster={bridalHeroPoster.src}
  />

  <section id="artistry" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="max-w-4xl mx-auto reveal">
      <blockquote class="font-body text-lg md:text-xl leading-relaxed text-center">
        Acreditamos que a maquilhagem de noiva e de eventos deve celebrar a tua essência. Com um
        olhar focado na naturalidade, criamos looks glowy e sunkissed, pensados para fotografar
        impecavelmente e mover-se contigo do início ao fim. O nosso objetivo é mostrar
        quem és através da tua makeup. Calma, fun ou bold: you name it, we make it!
      </blockquote>
    </div>
  </section>

  <section id="experiencia-bridal" class="max-w-container mx-auto px-6 md:px-16 pt-8 pb-3 md:pb-4 space-y-8">
    <div class="grid md:grid-cols-3 items-end gap-3 md:gap-4">
      <div class="relative md:col-span-1 hidden lg:block">
        <Image
          src={bridalExperience}
          alt="The Bridal Experience - maquilhagem de noiva luminosa"
          loading="lazy"
          decoding="async"
          data-lightbox="/images/bridal-experience.jpg"
          style="cursor: zoom-in;"
          class="aspect-[2/3] w-full object-cover"
        />
      </div>
      <div class="md:col-span-2 flex items-end">
        <div class="pb-12 md:px-12 md:text-justify">
          <h3 class="font-display font-bold text-2xl md:text-3xl leading-tight">{servicos[0].title}</h3>
          <p class="mt-3 text-xs uppercase tracking-widest text-burgundy">{servicos[0].extra}</p>
          <p class="text-darkbrown/75 text-base leading-relaxed mt-4">{servicos[0].desc}</p>
          {servicos[0].addon && <p class="text-burgundy text-sm mt-4">{servicos[0].addon}</p>}
        </div>
      </div>
    </div>
  </section>

  <section id="galeria-bridal" class="max-w-container mx-auto px-6 md:px-16 pb-32">
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:hidden" id="gallery-grid-bridal-mobile">
      {galeriaBridalCombo.map((item) => (
        <div class="gallery-item block w-full relative overflow-hidden rounded-sm group"
          data-lightbox={item.image?.src ?? ''}
          data-lightbox-video={item.video}
          data-category={item.category}>
          <GalleryMedia category={item.category} alt={item.alt} image={item.image} video={item.video} ratioClass="aspect-[3/4]" imgStyle={item.imgStyle} />
        </div>
      ))}
    </div>
    <div class="hidden lg:block">
      <Gallery items={galeriaBridal} showFilters={false} brick />
    </div>
  </section>

  <section id="cta" class="relative w-full overflow-hidden py-16 lg:py-40 text-center">
    <Image
      src={bridalCta}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-darkbrown/50"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-6">
      <h2 class="text-2xl md:text-display-l font-display font-bold text-offwhite md:whitespace-nowrap mb-8 reveal">Pronta para o teu glow especial?</h2>
      <div class="flex flex-wrap justify-center gap-4 reveal">
        <a href="#orcamento" class="border border-offwhite bg-transparent text-offwhite px-6 py-3.5 text-sm font-bold uppercase rounded-full hover:bg-offwhite hover:text-burgundy transition">Let's book</a>
      </div>
    </div>
  </section>

  <section id="experiencia-guests" class="max-w-container mx-auto px-6 md:px-16 pt-32 pb-3 md:pb-4 space-y-8">
    <div class="grid md:grid-cols-3 items-end gap-3 md:gap-4">
      <div class="md:col-span-2 flex items-end justify-end">
        <div class="pb-12 md:px-12 md:text-justify ml-auto">
          <h3 class="font-display font-bold text-2xl md:text-3xl leading-tight">{servicos[1].title}</h3>
          <p class="mt-3 text-xs uppercase tracking-widest text-burgundy">{servicos[1].extra}</p>
          <p class="text-darkbrown/75 text-base leading-relaxed mt-4">{servicos[1].desc}</p>
        </div>
      </div>
      <div class="relative md:col-span-1 overflow-hidden hidden lg:block">
        <Image
          src={guestsEvents}
          alt="Guests & Events - maquilhagem glowy e sunkissed"
          loading="lazy"
          decoding="async"
          data-lightbox="/images/guests-events.jpg"
          style="cursor: zoom-in;"
          class="aspect-[2/3] w-full h-full object-cover scale-125"
        />
      </div>
    </div>
  </section>

  <section id="galeria-guests" class="max-w-container mx-auto px-6 md:px-16 pb-28">
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:hidden" id="gallery-grid-guests-mobile">
      {galeriaGuestsCombo.map((item) => (
        <div class="gallery-item block w-full relative overflow-hidden rounded-sm group"
          data-lightbox={item.image?.src ?? ''}
          data-lightbox-video={item.video}
          data-category={item.category}>
          <GalleryMedia category={item.category} alt={item.alt} image={item.image} video={item.video} ratioClass="aspect-[3/4]" imgStyle={item.imgStyle} />
        </div>
      ))}
    </div>
    <div class="hidden lg:block">
      <Gallery items={galeriaGuests} showFilters={false} brick />
    </div>
  </section>

  <section id="orcamento" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">Pedir orçamento</p>
        <h2 class="text-display-m font-bold mb-4">Let's book your glow</h2>
      </div>
      <BridalForm />
    </div>
  </section>

  <Lightbox />
</Layout>

<style>
  .service-ph {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .group:hover .service-ph {
    transform: scale(1.03);
  }
</style>