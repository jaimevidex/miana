---
import Layout from '../../layouts/Layout.astro';
import BridalForm from '../../components/forms/BridalForm.astro';
import Gallery from '../../components/Gallery.astro';

const servicos = [
  {
    num: '01',
    title: 'The Bridal Experience',
    desc: 'O serviço de noiva desenhado à tua medida. Inclui a prova, a maquilhagem no dia do casamento e um touch-up kit.',
    extra: 'Formatos: Makeup ou Makeup + Hair (feito pela nossa equipa de hairstylists especializados).',
    addon: 'Add-on Skin Call: possibilidade de adicionar consultorias de skincare 1:1 nos meses anteriores para preparar a pele até ao grande dia. Inclui oferta especial.',
  },
  {
    num: '02',
    title: 'Bridal Party & Guests',
    desc: 'Serviço de maquilhagem e glam completo para madrinhas, mães, noivos e hóspedes.',
    extra: 'Formatos: Makeup ou Makeup + Hair.',
  },
  {
    num: '03',
    title: 'Event & Special Occasions',
    desc: 'Glam on demand para eventos, sessões fotográficas ou dias em que precisas simplesmente daquele glow extra.',
    extra: 'Formatos: Makeup ou Makeup + Hair.',
  },
];
---

<Layout title="Bridal & Beauty — Mariana" description="Maquilhagem de noiva e eventos com um acabamento luminoso e sunkissed. Bridal Experience, Bridal Party & Guests, Event & Special Occasions. Makeup ou Makeup + Hair.">
  <section class="pt-32 pb-16 max-w-container mx-auto px-6 md:px-16 text-center">
    <p class="eyebrow mb-4">Bridal &amp; beauty services on demand</p>
    <h1 class="text-display-l italic max-w-3xl mx-auto reveal">Luminous, sunkissed &amp; effortlessly you.</h1>
    <p class="text-darkbrown/70 mt-5 max-w-xl mx-auto reveal">
      Maquilhagem desenhada à tua medida, pensada para durar o dia todo e fazer-te sentir a tua
      melhor versão.
    </p>
  </section>

  <section class="max-w-container mx-auto px-6 md:px-16 pb-16">
    <div class="max-w-2xl mx-auto reveal">
      <blockquote class="font-display text-lg md:text-xl leading-relaxed text-center italic">
        Acreditamos que a maquilhagem de noiva e de eventos deve celebrar a tua essência. Com um
        olhar focado na naturalidade, criamos looks glowy e sunkissed, pensados para fotografar
        impecavelmente e moverem-se de forma contigo do início ao fim. O nosso objetivo é mostrar
        quem és através da tua makeup. Calma, fun ou bold: you name it, we make it!
      </blockquote>
    </div>
  </section>

  <section class="max-w-container mx-auto px-6 md:px-16 pb-16 grid md:grid-cols-3 gap-8">
    {servicos.map((s) => (
      <div class="border border-darkbrown/10 rounded-sm p-8 flex flex-col reveal">
        <span class="text-eyebrow text-burgundy/60 font-semibold">{s.num}</span>
        <h2 class="font-display text-2xl mt-3 mb-3">{s.title}</h2>
        <p class="text-darkbrown/70 text-sm flex-1">{s.desc}</p>
        {s.extra && <p class="text-darkbrown/55 text-xs mt-4">{s.extra}</p>}
        {s.addon && <p class="text-burgundy text-xs mt-3">{s.addon}</p>}
      </div>
    ))}
  </section>

  <section class="bg-darkbrown text-offwhite py-24">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <p class="eyebrow text-powder mb-4 text-center">Bridal gallery</p>
      <h2 class="text-display-l italic text-center mb-14 reveal">Glam de noivas</h2>
      <Gallery showFilters={false} />
    </div>
  </section>

  <section class="max-w-container mx-auto px-6 md:px-16 py-24">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">Pedir orçamento</p>
        <h2 class="text-display-m mb-4">Let's book your glow</h2>
        <p class="text-darkbrown/70 text-sm mb-2">
          Preenche o formulário e respondo em até 48h com todos os detalhes.
        </p>
      </div>
      <BridalForm />
    </div>
  </section>
</Layout>