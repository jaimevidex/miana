---
import Layout from '../../layouts/Layout.astro';
import BridalForm from '../../components/forms/BridalForm.astro';
import Gallery from '../../components/Gallery.astro';
import Hero from '../../components/Hero.astro';

const servicos = [
  {
    num: '01',
    title: 'The Bridal Experience',
    desc: 'Weddings are all about celebrating love. E porque cada noiva é única, a tua makeup deve refletir exatamente quem és e acompanhar-te do primeiro "sim" ao último segundo da festa, sem preocupações. Conta connosco para tornar a tua preparação num momento calmo, leve e inesquecível. A nossa Bridal Experience inclui prova, a makeup no dia do casamento e um touch-up kit.',
    extra: 'Makeup | Hair | Pack Makeup + Hair',
    addon: 'Add a Skin Call: Podes adicionar um plano de skincare 1:1 nos meses anteriores para preparar a pele até ao grande dia. Inclui oferta especial.',
  },
  {
    num: '02',
    title: 'Guests & Events',
    desc: 'A special moment calls for a special glow. Glam on demand para casamentos, eventos, sessões fotográficas ou dias em que precisas simplesmente de um glow extra. Um look tailored-made para ti, com a durabilidade que precisas para aproveitar o dia ao máximo.',
    extra: 'Makeup | Hair | Pack Makeup + Hair',
  },
];

const phTones = [
  'linear-gradient(135deg, #7a2430 0%, #59010b 60%, #2d1918 100%)',
  'linear-gradient(135deg, #bddaF4 0%, #8fb8d8 60%, #5d88ab 100%)',
];
---

<Layout title="Bridal & Beauty — Mariana" description="Maquilhagem de noiva e eventos com um acabamento luminoso e sunkissed. Bridal Experience, Bridal Party & Guests, Event & Special Occasions. Makeup ou Makeup + Hair." hasHero>
  <Hero
    eyebrow="Luminous, sunkissed & effortlessly you"
    title="Bridal & Beauty"
    sub="Maquilhagem on demand desenhada à tua medida, pensada para durar o dia todo e fazer-te sentir a tua melhor versão."
    video={[{ src: '/videos/bridal-hero.mp4', type: 'video/mp4' }]}
  />

  <section id="artistry" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="max-w-4xl mx-auto reveal">
      <blockquote class="font-body text-lg md:text-xl leading-relaxed text-center">
        Acreditamos que a maquilhagem de noiva e de eventos deve celebrar a tua essência. Com um
        olhar focado na naturalidade, criamos looks glowy e sunkissed, pensados para fotografar
        impecavelmente e mover-se contigo do início ao fim. O nosso objetivo é mostrar
        quem és através da tua makeup. Calma, fun ou bold: you name it, we make it!
      </blockquote>
    </div>
  </section>

  <section id="experiencia" class="max-w-container mx-auto px-6 md:px-16 pt-4 pb-40 space-y-24">
      <div class="grid md:grid-cols-3 items-end">
        <div class="relative md:col-span-1">
          <img
            src="/images/bridal-experience.jpg"
            alt="The Bridal Experience — maquilhagem de noiva luminosa"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full object-cover"
          />
        </div>
        <div class="md:col-span-2 flex items-end">
          <div class="pl-4 md:pl-6 pb-4 max-w-lg">
            <h3 class="font-display font-bold text-2xl md:text-3xl leading-tight">{servicos[0].title}</h3>
            <p class="mt-3 text-xs uppercase tracking-widest text-burgundy">{servicos[0].extra}</p>
            <p class="text-darkbrown/75 text-base leading-relaxed mt-4">{servicos[0].desc}</p>
            {servicos[0].addon && <p class="text-burgundy text-sm mt-4">{servicos[0].addon}</p>}
          </div>
        </div>
      </div>

      <!-- Fila 2: imagem à direita (último terço), texto nos outros dois terços encostado à imagem -->
      <div class="grid md:grid-cols-3 items-end">
        <div class="md:col-span-2 flex items-end justify-end">
          <div class="pr-4 md:pr-6 pb-4 max-w-lg text-right">
            <h3 class="font-display font-bold text-2xl md:text-3xl leading-tight">{servicos[1].title}</h3>
            <p class="mt-3 text-xs uppercase tracking-widest text-burgundy">{servicos[1].extra}</p>
            <p class="text-darkbrown/75 text-base leading-relaxed mt-4">{servicos[1].desc}</p>
          </div>
        </div>
        <div class="relative md:col-span-1">
          <img
            src="/images/guests-events.jpg"
            alt="Guests & Events — maquilhagem glowy e sunkissed"
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full object-cover"
          />
        </div>
      </div>
    </section>

  <section id="cta" class="relative w-full overflow-hidden py-56 text-center">
    <img src="/images/bridal-cta.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async"
      class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-darkbrown/50"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-6">
      <h2 class="text-2xl md:text-display-l font-display font-bold text-offwhite whitespace-nowrap mb-8 reveal">Pronta para o teu glow especial?</h2>
      <div class="flex flex-wrap justify-center gap-4 reveal">
        <a href="#orcamento" class="border border-offwhite bg-transparent text-offwhite px-6 py-3.5 text-sm font-bold uppercase rounded-full hover:bg-offwhite hover:text-burgundy transition">Let's book</a>
      </div>
    </div>
  </section>

  <section id="galeria" class="py-32">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <p class="eyebrow text-burgundy mb-12 text-center">Take a look</p>
      <Gallery showFilters={false} brick />
    </div>
  </section>

  <section id="orcamento" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">Pedir orçamento</p>
        <h2 class="text-display-m font-bold mb-4">Let's book your glow</h2>
      </div>
      <BridalForm />
    </div>
  </section>
</Layout>

<style>
  .service-ph {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .group:hover .service-ph {
    transform: scale(1.03);
  }
</style>