---
import Layout from '../../layouts/Layout.astro';
import SkinCallForm from '../../components/forms/SkinCallForm.astro';
import Hero from '../../components/Hero.astro';

const planos = [
  {
    num: '01',
    nome: 'One Time Call',
    value: 'One Time Call (Plano 3M)',
    meta: '1 sessão | Plano a 3 meses',
    desc: 'Ideal se tens necessidades básicas e precisas de ajustes simples na rotina.',
    foco: 'Saúde da pele, hidratação e luminosidade',
    preco: '80€',
    precoOriginal: null,
  },
  {
    num: '02',
    nome: 'Duo Call',
    value: 'Duo Call (Plano 6M)',
    meta: '2 sessões | Plano a 6 meses',
    desc: 'Se queres introduzir ativos simples e acompanhar a tua evolução.',
    foco: 'Textura e prevenção dos primeiros sinais de idade',
    preco: '150€',
    precoOriginal: '160€',
  },
  {
    num: '03',
    nome: 'Triple Call',
    value: 'Triple Call (Plano 9M)',
    meta: '3 sessões | Plano a 9 meses',
    desc: 'Para introduzir o uso de ativos complexos, com supervisão dedicada.',
    foco: 'Manchas, anti-aging e borbulhas persistentes',
    preco: '210€',
    precoOriginal: '240€',
  },
  {
    num: '04',
    nome: 'Full Year Call',
    value: 'Full Year Call (Plano 12M)',
    meta: '4 sessões | Plano a 12 meses',
    desc: 'Para gerir preocupações profundas, progressão de ativos complexos e ajustes sazonais.',
    foco: 'Progressão de ativos complexos e adaptação sazonal',
    preco: '260€',
    precoOriginal: '320€',
  },
];

const processo = [
  { num: '#1', titulo: 'The Call', desc: 'Videochamada 1:1 onde avaliamos as necessidades da tua pele e os produtos que já usas, de forma a rentabilizar o que tens e eliminar o que está a mais.' },
  { num: '#2', titulo: 'The Strategy', desc: 'Definimos uma estratégia e plano de ação à tua medida, adaptado ao plano que escolheres e aos objetivos da tua pele. Abaixo podes consultar os 4 planos.' },
  { num: '#3', titulo: 'The Protocol', desc: 'Desenhamos uma rotina de skincare intencional e adaptada ao teu orçamento e rotina, com a indicação dos produtos mais adequados para ti e a ordem exata de aplicação.' },
  { num: '#4', titulo: 'The Aftercare', desc: 'Garantimos um acompanhamento pós-call se necessitares de ajustes na tua rotina e para esclarecer qualquer dúvida durante o processo.' },
];
---

<Layout title="The Skin Call — Consultoria de Skincare | Mariana" description="A tua pele analisada através da ciência. Consultorias 1:1 de skincare com planos de 3, 6, 9 ou 12 meses, guiadas por uma mestra em Cosmetologia Avançada." hasHero>
  <Hero
    eyebrow="Skin Analysis & Skincare Routine Design"
    title="The Skin Call"
    sub="A tua pele analisada através da ciência. Uma rotina de skincare simplificada e intencional, desenhada para o teu dia a dia e necessidades."
    video={[{ src: '/videos/skin-call-hero.mp4', type: 'video/mp4' }]}
  />

  <section id="intro" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="max-w-4xl mx-auto reveal">
      <blockquote class="font-body text-lg md:text-xl leading-relaxed text-center">
        O mundo do skincare pode ser avassalador. Entre dezenas de produtos, tendências e
        rotinas complexas, é fácil acumular passos sem saber o que a tua pele realmente precisa.
        A Skin Call nasce para descomplicar. Unindo a Bioquímica à Cosmetologia Avançada,
        analisamos a ciência por trás dos teus produtos e a biologia da tua pele para criar uma
        rotina de skincare simplificada, eficaz e feita à tua medida.
      </blockquote>
    </div>
  </section>

  <section id="como-funciona" class="max-w-container mx-auto px-6 md:px-16 pb-24">
    <h2 class="text-display-l font-bold text-center text-burgundy mb-12 reveal">Como Funciona</h2>
    <div class="grid md:grid-cols-4 gap-8">
      {processo.map((p) => (
        <div class="border border-darkbrown/10 rounded-sm p-8 reveal">
          <span class="font-script text-3xl text-burgundy">{p.num}</span>
          <h3 class="font-display text-xl mt-3 mb-2">{p.titulo}</h3>
          <p class="text-darkbrown/65 text-base leading-tight">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="planos" class="bg-powder/40 text-darkbrown py-32">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <h2 class="text-display-l font-bold text-center text-burgundy mb-14 reveal">Escolhe o teu plano</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {planos.map((p) => (
          <button
            type="button"
            data-value={p.value}
            class="border border-burgundy/40 rounded-sm p-6 flex flex-col text-left reveal cursor-pointer transition hover:border-burgundy hover:shadow-lg hover:scale-[1.03]"
          >
            <h3 class="font-display text-2xl mb-1">{p.nome}</h3>
            <p class="text-burgundy/80 text-sm font-semibold mb-3">{p.meta}</p>
            <p class="text-darkbrown/80 text-base flex-1 leading-tight">{p.desc}</p>
            <p class="text-darkbrown/60 text-sm mt-4">Foco: {p.foco}</p>
            <div class="mt-6">
              {p.precoOriginal && (
                <span class="font-display text-xl text-darkbrown/50 line-through mr-2">{p.precoOriginal}</span>
              )}
              <span class="font-display text-3xl text-burgundy font-bold">{p.preco}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section id="skin-call-form" class="max-w-container mx-auto px-6 md:px-16 py-32">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">Descobre o teu plano</p>
        <h2 class="text-display-m font-bold mb-4">Ready to simplify your skin routine?</h2>
      </div>
      <SkinCallForm />
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('button[data-value]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.getAttribute('data-value') ?? '';
        const form = document.getElementById('skin-call-form');
        form?.scrollIntoView({ behavior: 'smooth', block: 'start' });

        const radio = document.querySelector<HTMLInputElement>(
          `input[name="plano"][value="${CSS.escape(value)}"]`
        );
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    });
  </script>
</Layout>
