---
import Layout from '../../layouts/Layout.astro';
import SkinCallForm from '../../components/forms/SkinCallForm.astro';
import Hero from '../../components/Hero.astro';

const planos = [
  {
    num: '01',
    nome: 'One Time Call',
    meta: '1 sessão | Plano a 3 meses',
    desc: 'Ideal se tens necessidades básicas e precisas de ajustes simples na rotina.',
    foco: 'Saúde da pele, hidratação e luminosidade',
  },
  {
    num: '02',
    nome: 'Duo Call',
    meta: '2 sessões | Plano a 6 meses',
    desc: 'Se queres introduzir ativos simples e acompanhar a tua evolução.',
    foco: 'Textura e prevenção dos primeiros sinais de idade',
  },
  {
    num: '03',
    nome: 'Triple Call',
    meta: '3 sessões | Plano a 9 meses',
    desc: 'Para introduzir o uso de ativos complexos, com supervisão dedicada.',
    foco: 'Manchas, anti-aging e borbulhas persistentes',
  },
  {
    num: '04',
    nome: 'Full Year Call',
    meta: '4 sessões | Plano a 12 meses',
    desc: 'Para gerir preocupações profundas, progressão de ativos complexos e ajustes sazonais.',
    foco: 'Progressão de ativos complexos e adaptação sazonal',
  },
];

const processo = [
  { num: '#1', titulo: 'The Call', desc: 'Videochamada 1:1 onde avaliamos as necessidades da tua pele e os produtos que já usas, de forma a rentabilizar o que tens e eliminar o que está a mais.' },
  { num: '#2', titulo: 'The Strategy', desc: 'Definimos uma estratégia e plano de ação à tua medida, adaptado ao tempo que escolheres e aos objetivos da tua pele. Podes escolher entre 4 opções.' },
  { num: '#3', titulo: 'The Protocol', desc: 'Desenhamos uma rotina de skincare intencional e adaptada ao teu orçamento, com a indicação dos ingredientes certos, produtos mais adequados e a ordem exata de aplicação.' },
  { num: '#4', titulo: 'The Aftercare', desc: 'Garantimos um acompanhamento pós-call se necessitares de ajustes na tua rotina e para esclarecer qualquer dúvida durante o processo.' },
];
---

<Layout title="The Skin Call — Consultoria de Skincare | Mariana" description="A tua pele analisada através da ciência. Consultorias 1:1 de skincare com planos de 3, 6, 9 ou 12 meses, guiadas por uma mestra em Cosmetologia Avançada." hasHero>
  <Hero
    eyebrow="Skin Analysis & Skincare Routine Design"
    title="The Skin Call"
    sub="A tua pele analisada através da ciência. Uma rotina de skincare simplificada e intencional, desenhada para o teu dia a dia e necessidades."
  />

  <section class="max-w-container mx-auto px-6 md:px-16 pb-16">
    <div class="max-w-2xl mx-auto reveal">
      <blockquote class="font-display text-lg md:text-xl leading-relaxed text-center italic">
        O mundo da cosmetologia pode ser avassalador. Entre dezenas de produtos, tendências e
        rotinas complexas, é fácil acumular passos sem saber o que a tua pele realmente precisa.
        A Skin Call nasce para descomplicar. Unindo a Bioquímica à Cosmetologia Avançada,
        analisamos a ciência por trás dos teus produtos e a biologia da tua pele para criar um
        ritual de skincare simplificado, eficaz e feito à tua medida.
      </blockquote>
    </div>
  </section>

  <section class="max-w-container mx-auto px-6 md:px-16 pb-16">
    <p class="eyebrow text-center mb-4">Como funciona</p>
    <h2 class="text-display-l italic text-center mb-12 reveal">O processo</h2>
    <div class="grid md:grid-cols-4 gap-8">
      {processo.map((p) => (
        <div class="border border-darkbrown/10 rounded-sm p-6 reveal">
          <span class="font-script text-2xl text-burgundy">{p.num}</span>
          <h3 class="font-display text-lg mt-3 mb-2">{p.titulo}</h3>
          <p class="text-darkbrown/65 text-sm">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-burgundy text-offwhite py-24">
    <div class="max-w-container mx-auto px-6 md:px-16">
      <p class="eyebrow text-powder mb-4 text-center">Os planos</p>
      <h2 class="text-display-l italic text-center mb-12 reveal">Escolhe o teu plano</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {planos.map((p) => (
          <div class="border border-offwhite/25 rounded-sm p-6 flex flex-col reveal">
            <span class="font-script text-2xl text-powder">{p.num}</span>
            <h3 class="font-display text-xl mt-3 mb-1">{p.nome}</h3>
            <p class="text-powder/80 text-xs font-semibold mb-3">{p.meta}</p>
            <p class="text-offwhite/80 text-sm flex-1">{p.desc}</p>
            <p class="text-offwhite/60 text-xs mt-4">{p.foco}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="skin-call-form" class="max-w-container mx-auto px-6 md:px-16 py-24">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="eyebrow mb-4">Descobre o teu plano</p>
        <h2 class="text-display-m mb-4">Ready to simplify your skin routine?</h2>
        <p class="text-darkbrown/70 text-sm mt-2">Responde ao pequeno diagnóstico e recomendamos o plano ideal para ti.</p>
      </div>
      <SkinCallForm />
    </div>
  </section>
</Layout>
